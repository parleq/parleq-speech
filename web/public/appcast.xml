<?xml version="1.0" encoding="utf-8"?>
<!--
  Parleq Sparkle appcast.

  Served at https://parleq.app/appcast.xml (configured as
  SUFeedURL in parleq-app/Resources/Info.plist). Sparkle on
  installed Parleq builds fetches this file on launch + on a
  ~24h timer and prompts the user when the latest <item> below
  describes a newer version than the running build.

  Each <item>'s `sparkle:edSignature` is an Ed25519 signature
  over the linked .dmg's bytes, produced by Sparkle's
  `sign_update` tool against the maintainer's private key. The
  matching public key ships inside every Parleq build via
  Info.plist's `SUPublicEDKey`. Sparkle refuses any update
  whose enclosure signature doesn't verify against that exact
  public key, so a downstream attacker who swaps either the
  appcast file or the .dmg cannot push an arbitrary binary to
  existing installs.

  Items are inserted by `make release`: see the Makefile's
  release recipe for the sed insertion against the
  PARLEQ_APPCAST_INSERT marker below. The newest entry goes
  immediately above the marker, so the top of the <channel>
  is always the freshest release.

  Empty channel ships in 0.10.0 (the release that introduces
  Sparkle). The first <item> gets emitted whenever the next
  `make release` runs; until then, installed builds checking
  this URL see an empty feed and report "you're up to date."
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
    <channel>
        <title>Parleq</title>
        <link>https://parleq.app/appcast.xml</link>
        <description>Updates to Parleq, the local-first AI dictation app for macOS.</description>
        <language>en</language>
        <!-- PARLEQ_APPCAST_INSERT — `make release` inserts new <item> blocks
             on the line immediately above this marker. Don't remove. -->
    </channel>
</rss>
