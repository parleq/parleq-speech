---
interface Props {
  showLegend?: boolean;
}

const { showLegend = true } = Astro.props;

const helpers = [
  { label: 'Voiceprints', icon: 'mic' },
  { label: 'Questions', icon: 'question' },
  { label: 'Numbers', icon: 'hash' },
  { label: 'Dictionary', icon: 'book' },
  { label: 'Compound', icon: 'link' },
];
const bunch8 = [
  { x: 54, y: 40 }, { x: 90, y: 40 },
  { x: 36, y: 72 }, { x: 72, y: 72 }, { x: 108, y: 72 },
  { x: 54, y: 104 }, { x: 90, y: 104 },
  { x: 72, y: 134 },
];
const grapeIcon: Record<number, string> = { 3: 'mic', 1: 'question', 4: 'hash', 5: 'book', 6: 'link' };
const icons: Record<string, string> = {
  mic:   '<rect x="6" y="3" width="4" height="7" rx="2"/><path d="M4.5 8.5a3.5 3.5 0 0 0 7 0"/><path d="M8 12v2.4"/>',
  question: '<path d="M5.8 6.2a2.2 2.2 0 1 1 2.9 2.1c-.7.3-1.1.9-1.1 1.6"/><path d="M7.6 12.4h.01"/>',
  hash:  '<path d="M6.4 3.6 5 14.4M11.2 3.6 9.8 14.4M3 7.2h10M2.6 10.8h10"/>',
  book:  '<path d="M8 5C6.2 3.9 4.2 3.9 2.7 4.7V13c1.5-.8 3.5-.8 5.3.4M8 5c1.8-1.1 3.8-1.1 5.3-.3V13c-1.5-.8-3.5-.8-5.3.4M8 5v8.4"/>',
  link:  '<path d="M6.6 7a2.4 2.4 0 0 0 0 4.8M9.4 7a2.4 2.4 0 0 1 0 4.8"/><path d="M6 9.4h4"/>',
};
const emboss = (d: string) =>
  `<g transform="translate(0,0.85)" stroke="#cba9ec" stroke-opacity="0.5" stroke-width="1.35" fill="none" stroke-linecap="round" stroke-linejoin="round">${d}</g>` +
  `<g stroke="#27103e" stroke-opacity="0.92" stroke-width="1.35" fill="none" stroke-linecap="round" stroke-linejoin="round">${d}</g>`;
---

<!-- hidden defs shared by both the bunch and the legend grape icons -->
<svg width="0" height="0" class="absolute" aria-hidden="true"><defs>
  <radialGradient id="cgrape" cx="38%" cy="32%" r="70%"><stop offset="0%" stop-color="var(--color-grape-300)"></stop><stop offset="55%" stop-color="var(--color-grape-500)"></stop><stop offset="100%" stop-color="var(--color-grape-strong)"></stop></radialGradient>
  <radialGradient id="cleaf" cx="35%" cy="30%" r="80%"><stop offset="0%" stop-color="#7bb564"></stop><stop offset="100%" stop-color="#3f7a39"></stop></radialGradient>
</defs></svg>

<div class="flex flex-col items-center gap-10 sm:flex-row sm:justify-center sm:gap-16">
  <!-- The chosen cluster: full bunch with debossed impressions on the named grapes -->
  <svg viewBox="0 0 144 160" class="h-[200px] w-[180px]" aria-hidden="true">
    <path d="M72 6 C 72 16, 72 22, 72 30" fill="none" stroke="#6b4a2a" stroke-width="3" stroke-linecap="round"></path>
    <path d="M72 12 C 86 4, 100 6, 104 14 C 98 22, 84 22, 72 18 Z" fill="url(#cleaf)"></path>
    {bunch8.map((g, i) => (
      <g>
        <circle cx={g.x} cy={g.y} r="20" fill="url(#cgrape)" stroke="var(--color-grape-strong)" stroke-width="0.75"></circle>
        <ellipse cx={g.x - 5} cy={g.y - 6} rx="4.8" ry="3.2" fill="#fff" opacity="0.2"></ellipse>
        {grapeIcon[i] && <svg x={g.x - 8} y={g.y - 9} width="16" height="18" viewBox="0 0 16 18" set:html={emboss(icons[grapeIcon[i]])}></svg>}
      </g>
    ))}
  </svg>

  {showLegend && (
    <ul class="space-y-3">
      {helpers.map((h) => (
        <li class="flex items-center gap-3 text-[15px] font-medium text-[color:var(--color-text)]">
          <svg viewBox="0 0 24 24" class="h-7 w-7 shrink-0" aria-hidden="true">
            <circle cx="12" cy="12" r="10" fill="url(#cgrape)" stroke="var(--color-grape-strong)" stroke-width="0.75"></circle>
            <ellipse cx="9" cy="9" rx="2.6" ry="1.7" fill="#fff" opacity="0.22"></ellipse>
            <svg x="4" y="3" width="16" height="18" viewBox="0 0 16 18" set:html={emboss(icons[h.icon])}></svg>
          </svg>
          {h.label}
        </li>
      ))}
    </ul>
  )}
</div>
