---
// Shared sticky site header. Every page used to hand-roll this same
// <header>/<nav> with one nav item rendered as the current-page span.
// Extracted here so the markup lives in one place; the `active` prop
// picks which item renders as plain (non-link) current-page text.
//
// Sticky: a full-width bar with a translucent backdrop so content
// scrolling under it stays legible. A bottom hairline border fades in
// only once the page is scrolled (inline passive-scroll script) so the
// bar reads as flush at the top and lifts off the page once you move.
import Logo from './Logo.astro';

interface Props {
  // Which nav item is the current page. `none` (or omitted) renders
  // every item as a link — used by pages with no nav representation.
  active?: 'home' | 'how-it-works' | 'docs' | 'enterprise' | 'faq' | 'about' | 'none';
}

const { active = 'none' } = Astro.props;

const repoUrl = 'https://github.com/parleq/parleq-speech';
const base = `${import.meta.env.BASE_URL}`.replace(/\/$/, '');

// Internal nav items. Each renders as a muted hover-link unless it is
// the active page, in which case it's plain current-page text.
const items = [
  { key: 'home', label: 'Home', href: base + '/' },
  { key: 'how-it-works', label: 'How it works', href: base + '/how-it-works/' },
  { key: 'docs', label: 'Docs', href: base + '/docs/' },
  { key: 'enterprise', label: 'Enterprise', href: base + '/enterprise/' },
  { key: 'faq', label: 'FAQ', href: base + '/faq/' },
  { key: 'about', label: 'About', href: base + '/about/' },
];
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-white/5 backdrop-blur-md transition-colors"
  style="background: #1b0c30e6;"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href={base + '/'} class="inline-flex items-center">
      <Logo dark height="32" />
    </a>
    <nav class="flex items-center gap-6 text-sm font-medium text-[color:var(--color-grape-100)]">
      {items.map((item) =>
        item.key === active ? (
          <span class="text-white">{item.label}</span>
        ) : (
          <a href={item.href} class="transition-colors hover:text-white">{item.label}</a>
        )
      )}
      <a href={repoUrl} class="transition-colors hover:text-white">GitHub →</a>
    </nav>
  </div>
</header>

<!-- Reveal the bottom hairline only once scrolled past the very top, so
     the sticky bar sits flush at rest and gains a subtle separator as
     content slides beneath it. Passive listener; no-JS visitors get a
     borderless (still legible) translucent bar. -->
<script is:inline>
  (() => {
    const header = document.getElementById('site-header');
    if (!header) return;
    const sync = () => {
      const scrolled = window.scrollY > 8;
      header.classList.toggle('border-white/20', scrolled);
      header.classList.toggle('border-white/5', !scrolled);
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  })();
</script>
