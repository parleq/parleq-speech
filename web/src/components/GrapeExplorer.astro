    .demo-stack { width: 100%; max-width: 100%; margin-top: 2rem; }
    .demo-card { max-width: 100%; }
    .demo-card > .flex { flex-wrap: wrap; }
    .ba-before, .ba-after { overflow-wrap: anywhere; }
