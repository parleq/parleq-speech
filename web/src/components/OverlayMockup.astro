---
// OverlayMockup: a pure-HTML/Tailwind rendering of Parleq's floating
// dictation overlay, used as the product-mockup half of each scenario
// slide in the Refinement carousel. Not a screenshot — a CSS-built
// frame that captures the real overlay's recognizable anatomy:
//
//   - dark rounded panel with a subtle border + shadow
//   - faint top hint row ("Add a reference window for context") with a
//     model chip on the right (e.g. "2.5 Flash")
//   - main transcript text (the <slot/>, kept short)
//   - optional amber-tinted preset chip row (pill outlines, one active)
//   - bottom row: "PASTING TO <app>" on the left, Copy / Cancel / Accept
//     on the right — Accept filled amber, the others subtle
//
// Every slide reuses this one component and varies it through props, so
// the five scenarios all read as the same product surface.

interface PresetChip {
  label: string;
  active?: boolean;
}

interface Props {
  /** App name shown after "PASTING TO" in the bottom-left status. */
  pastingTo?: string;
  /** Model chip label on the top hint row (e.g. "2.5 Flash"). */
  model?: string;
  /** Text of the faint top hint row. */
  hint?: string;
  /**
   * Emphasize the hint row (brighter text, amber dot) — used by the
   * Reference Windows slide where the hint is the whole point.
   */
  hintProminent?: boolean;
  /** Preset chips for the amber-tinted chip row; omit to hide the row. */
  presets?: PresetChip[];
  /** A small refine-instruction line under the transcript (quoted, accent-barred). */
  refine?: string;
  /**
   * An attachment pill under the transcript (e.g. "Calendar — window
   * attached") — used by the Reference Windows slide.
   */
  attachment?: string;
}

const {
  pastingTo = 'Mail',
  model = '2.5 Flash',
  hint = 'Add a reference window for context',
  hintProminent = false,
  presets,
  refine,
  attachment,
} = Astro.props;
---

<!-- The overlay panel. Dark slate ground regardless of page theme,
     matching the real in-app overlay which is always dark. -->
<div class="w-full max-w-md rounded-xl border border-white/10 bg-[#1c2128] p-4 shadow-2xl shadow-black/30 ring-1 ring-black/5">
  <!-- Top hint row + model chip. Faint by default; the Reference
       Windows slide flips it prominent. -->
  <div class="flex items-center justify-between gap-3">
    <span
      class:list={[
        'inline-flex items-center gap-1.5 text-[11px]',
        hintProminent ? 'font-medium text-[#cbd5e1]' : 'text-white/40',
      ]}
    >
      {hintProminent && (
        <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-[color:var(--color-accent)]"></span>
      )}
      {hint}
    </span>
    <span class="shrink-0 rounded-md border border-white/10 bg-white/5 px-2 py-0.5 font-mono text-[10px] text-white/55">
      {model}
    </span>
  </div>

  <!-- Main transcript text. Kept short per-slide; passed as the slot. -->
  <p class="mt-3 text-[14px] leading-relaxed text-[#e2e8f0]">
    <slot />
  </p>

  <!-- Refine-instruction line (slide 1/2): what you say to reshape it. -->
  {refine && (
    <p class="mt-3 border-l-2 border-[color:var(--color-accent)]/60 pl-3 text-[13px] leading-relaxed text-white/75">
      {refine}
    </p>
  )}

  <!-- Attachment pill (slide 4): a reference window now in context. -->
  {attachment && (
    <div class="mt-3 inline-flex items-center gap-1.5 rounded-md border border-[color:var(--color-accent)]/40 bg-[color:var(--color-accent)]/10 px-2.5 py-1 text-[11px] font-medium text-[#fcd9a3]">
      <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-[color:var(--color-accent)]"></span>
      {attachment}
    </div>
  )}

  <!-- Preset chip row (slide 3): amber-tinted pill outlines; the active
       one is filled. -->
  {presets && presets.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {presets.map((chip) => (
        <span
          class:list={[
            'rounded-full border px-3 py-1 text-[11px] font-medium',
            chip.active
              ? 'border-[color:var(--color-accent)] bg-[color:var(--color-accent)]/20 text-[#fcd9a3]'
              : 'border-white/15 text-white/55',
          ]}
        >
          {chip.label}
        </span>
      ))}
    </div>
  )}

  <!-- Bottom row: paste target on the left, actions on the right.
       Accept is the filled-amber primary; Copy/Cancel stay subtle. -->
  <div class="mt-4 flex items-center justify-between gap-3 border-t border-white/10 pt-3">
    <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-white/40">
      Pasting to {pastingTo}
    </span>
    <div class="flex items-center gap-2">
      <span class="rounded-md px-2.5 py-1 text-[11px] font-medium text-white/55">Copy</span>
      <span class="rounded-md px-2.5 py-1 text-[11px] font-medium text-white/55">Cancel</span>
      <span class="rounded-md bg-[color:var(--color-accent)] px-3 py-1 text-[11px] font-semibold text-white">Accept</span>
    </div>
  </div>
</div>
