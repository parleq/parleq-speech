---
import Logo from './Logo.astro';

interface Props {
  downloadUrl: string;
}

const { downloadUrl } = Astro.props;

const repoUrl = 'https://github.com/parleq/parleq-speech';
const base = `${import.meta.env.BASE_URL}`.replace(/\/$/, '');

const navItems = [
  { label: 'How it works', href: `${base}/how-it-works/` },
  { label: 'Docs', href: `${base}/docs/` },
  { label: 'Enterprise', href: `${base}/enterprise/` },
  { label: 'About', href: `${base}/about/` },
];
---

<header
  id="sticky-header"
  class="pointer-events-none fixed inset-x-0 top-0 z-50 -translate-y-full border-b border-[color:var(--color-border)] bg-[color:var(--color-bg)]/85 opacity-0 backdrop-blur-md"
  aria-hidden="true"
  inert=""
>
  <div class="mx-auto flex max-w-[1700px] items-center justify-between px-4 py-3 sm:px-6">
    <a href={base + '/'} class="inline-flex items-center">
      <Logo height="26" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-5 text-sm font-medium text-[color:var(--color-text-muted)] md:flex">
      {navItems.map((item) => (
        <a href={item.href} class="transition-colors hover:text-[color:var(--color-text)]">{item.label}</a>
      ))}
      <a href={repoUrl} class="transition-colors hover:text-[color:var(--color-text)]">GitHub ↗</a>
      <a
        href={downloadUrl}
        data-goatcounter-click="download-sticky"
        class="inline-flex items-center gap-1.5 rounded-full bg-[color:var(--color-accent)] px-4 py-1.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        Download for macOS
      </a>
    </nav>

    <!-- Mobile hamburger (light bg → dark icon) -->
    <button
      id="sticky-menu-btn"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="sticky-mobile-menu"
      class="inline-flex h-9 w-9 items-center justify-center rounded-md text-[color:var(--color-text)] md:hidden"
    >
      <svg id="sticky-hamburger-icon" aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="6" x2="20" y2="6" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="18" x2="20" y2="18" />
      </svg>
      <svg id="sticky-close-icon" aria-hidden="true" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="18" y1="6" x2="6" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Mobile dropdown -->
  <div
    id="sticky-mobile-menu"
    hidden
    class="border-t border-[color:var(--color-border)] bg-[color:var(--color-bg)] px-4 pb-4 pt-3 md:hidden"
  >
    <nav class="flex flex-col gap-1 text-sm font-medium">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="py-2 text-[color:var(--color-text-muted)] transition-colors hover:text-[color:var(--color-text)]"
        >
          {item.label}
        </a>
      ))}
      <a
        href={repoUrl}
        class="py-2 text-[color:var(--color-text-muted)] transition-colors hover:text-[color:var(--color-text)]"
      >
        GitHub ↗
      </a>
      <a
        href={downloadUrl}
        data-goatcounter-click="download-sticky"
        class="mt-2 inline-flex items-center justify-center gap-1.5 rounded-full bg-[color:var(--color-accent)] px-4 py-2.5 text-sm font-semibold text-white"
      >
        Download for macOS
      </a>
    </nav>
  </div>
</header>

<style>
  /* Motion-gated slide/fade transition. Reduced-motion users get instant show/hide. */
  #sticky-header {
    transition: transform 250ms ease, opacity 250ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    #sticky-header {
      transition: none;
    }
  }
</style>

<script is:inline>
(function () {
  var header = document.getElementById('sticky-header');
  var btn = document.getElementById('sticky-menu-btn');
  var menu = document.getElementById('sticky-mobile-menu');
  var hamburgerIcon = document.getElementById('sticky-hamburger-icon');
  var closeIcon = document.getElementById('sticky-close-icon');

  if (!header) return;

  function reveal(show) {
    if (show) {
      header.classList.remove('pointer-events-none', 'opacity-0', '-translate-y-full');
      header.removeAttribute('aria-hidden');
      header.removeAttribute('inert');
    } else {
      closeMenu();
      header.classList.add('pointer-events-none', 'opacity-0', '-translate-y-full');
      header.setAttribute('aria-hidden', 'true');
      header.setAttribute('inert', '');
    }
  }

  function openMenu() {
    if (!menu || !btn) return;
    menu.removeAttribute('hidden');
    btn.setAttribute('aria-expanded', 'true');
    btn.setAttribute('aria-label', 'Close navigation menu');
    if (hamburgerIcon) hamburgerIcon.classList.add('hidden');
    if (closeIcon) closeIcon.classList.remove('hidden');
    var first = menu.querySelector('a');
    if (first) first.focus();
  }

  function closeMenu() {
    if (!menu || !btn) return;
    menu.setAttribute('hidden', '');
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', 'Open navigation menu');
    if (hamburgerIcon) hamburgerIcon.classList.remove('hidden');
    if (closeIcon) closeIcon.classList.add('hidden');
  }

  if (btn) {
    btn.addEventListener('click', function () {
      if (btn.getAttribute('aria-expanded') === 'true') closeMenu();
      else openMenu();
    });
  }

  // Close on Escape — return focus to the toggle button.
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && btn && btn.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      btn.focus();
    }
  });

  // Close on outside click.
  document.addEventListener('click', function (e) {
    if (btn && menu && !header.contains(e.target)) {
      closeMenu();
    }
  });

  // Reveal via IntersectionObserver on #hero-sentinel (rendered after this component).
  // Deferred to DOMContentLoaded so the sentinel element exists.
  document.addEventListener('DOMContentLoaded', function () {
    var sentinel = document.getElementById('hero-sentinel');
    if (!sentinel) return;

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          // Only reveal when the sentinel has scrolled ABOVE the viewport —
          // prevents a false-show when a tall hero pushes the sentinel below the fold on load.
          var scrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          reveal(scrolledPast);
        });
      },
      { threshold: 0 }
    );
    observer.observe(sentinel);
  });
})();
</script>
