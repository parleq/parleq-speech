---
import Logo from './Logo.astro';

interface Props {
  downloadUrl: string;
  /** 'grape' matches the hero (dark); 'light' matches the warm-white page body. */
  tone?: 'grape' | 'light';
}

const { downloadUrl, tone = 'grape' } = Astro.props;

const repoUrl = 'https://github.com/parleq/parleq-speech';
const base = `${import.meta.env.BASE_URL}`.replace(/\/$/, '');

const navItems = [
  { label: 'How it works', href: `${base}/how-it-works/` },
  { label: 'Docs', href: `${base}/docs/` },
  { label: 'Enterprise', href: `${base}/enterprise/` },
  { label: 'About', href: `${base}/about/` },
];

const grape = tone === 'grape';
// Tone-dependent class strings (kept explicit so Tailwind sees full literals).
const barClass = grape
  ? 'border-b border-white/10 bg-[#1b0c30]/90 backdrop-blur-md'
  : 'border-b border-[color:var(--color-border)] bg-[color:var(--color-bg)]/85 backdrop-blur-md';
const linkClass = grape
  ? 'transition-colors text-[color:var(--color-grape-100)] hover:text-white'
  : 'transition-colors text-[color:var(--color-text-muted)] hover:text-[color:var(--color-text)]';
const iconBtnClass = grape ? 'text-white' : 'text-[color:var(--color-text)]';
const menuClass = grape
  ? 'border-t border-white/10 bg-[#1b0c30] px-4 pb-4 pt-3 md:hidden'
  : 'border-t border-[color:var(--color-border)] bg-[color:var(--color-bg)] px-4 pb-4 pt-3 md:hidden';
---

<header
  id="sticky-header"
  class:list={['pointer-events-none fixed inset-x-0 top-0 z-50 -translate-y-full opacity-0', barClass]}
  aria-hidden="true"
  inert=""
>
  <div class="mx-auto flex max-w-[1700px] items-center justify-between px-4 py-3 sm:px-6">
    <a href={base + '/'} class="inline-flex items-center">
      <Logo dark={grape} height="26" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-5 text-sm font-medium md:flex">
      {navItems.map((item) => (
        <a href={item.href} class={linkClass}>{item.label}</a>
      ))}
      <a href={repoUrl} class={linkClass}>GitHub ↗</a>
      <a
        href={downloadUrl}
        data-goatcounter-click="download-sticky"
        class="inline-flex items-center gap-1.5 rounded-full bg-[color:var(--color-accent)] px-4 py-1.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        Download for macOS
      </a>
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="sticky-menu-btn"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="sticky-mobile-menu"
      class:list={['inline-flex h-9 w-9 items-center justify-center rounded-md md:hidden', iconBtnClass]}
    >
      <svg id="sticky-hamburger-icon" aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="6" x2="20" y2="6" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="18" x2="20" y2="18" />
      </svg>
      <svg id="sticky-close-icon" aria-hidden="true" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="18" y1="6" x2="6" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Mobile dropdown -->
  <div id="sticky-mobile-menu" hidden class={menuClass}>
    <nav class="flex flex-col gap-1 text-sm font-medium">
      {navItems.map((item) => (
        <a href={item.href} class:list={['py-2', linkClass]}>{item.label}</a>
      ))}
      <a href={repoUrl} class:list={['py-2', linkClass]}>GitHub ↗</a>
      <a
        href={downloadUrl}
        data-goatcounter-click="download-sticky"
        class="mt-2 inline-flex items-center justify-center gap-1.5 rounded-full bg-[color:var(--color-accent)] px-4 py-2.5 text-sm font-semibold text-white"
      >
        Download for macOS
      </a>
    </nav>
  </div>
</header>

<style>
  /* Motion-gated slide/fade transition. Reduced-motion users get instant show/hide. */
  #sticky-header {
    transition: transform 250ms ease, opacity 250ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    #sticky-header {
      transition: none;
    }
  }
</style>

<script is:inline>
(function () {
  var header = document.getElementById('sticky-header');
  var btn = document.getElementById('sticky-menu-btn');
  var menu = document.getElementById('sticky-mobile-menu');
  var hamburgerIcon = document.getElementById('sticky-hamburger-icon');
  var closeIcon = document.getElementById('sticky-close-icon');

  if (!header) return;

  function reveal(show) {
    if (show) {
      header.classList.remove('pointer-events-none', 'opacity-0', '-translate-y-full');
      header.removeAttribute('aria-hidden');
      header.removeAttribute('inert');
    } else {
      closeMenu();
      header.classList.add('pointer-events-none', 'opacity-0', '-translate-y-full');
      header.setAttribute('aria-hidden', 'true');
      header.setAttribute('inert', '');
    }
  }

  function openMenu() {
    if (!menu || !btn) return;
    menu.removeAttribute('hidden');
    btn.setAttribute('aria-expanded', 'true');
    btn.setAttribute('aria-label', 'Close navigation menu');
    if (hamburgerIcon) hamburgerIcon.classList.add('hidden');
    if (closeIcon) closeIcon.classList.remove('hidden');
    var first = menu.querySelector('a');
    if (first) first.focus();
  }

  function closeMenu() {
    if (!menu || !btn) return;
    menu.setAttribute('hidden', '');
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', 'Open navigation menu');
    if (hamburgerIcon) hamburgerIcon.classList.remove('hidden');
    if (closeIcon) closeIcon.classList.add('hidden');
  }

  if (btn) {
    btn.addEventListener('click', function () {
      if (btn.getAttribute('aria-expanded') === 'true') closeMenu();
      else openMenu();
    });
  }

  // Close on Escape — return focus to the toggle button.
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && btn && btn.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      btn.focus();
    }
  });

  // Close on outside click.
  document.addEventListener('click', function (e) {
    if (btn && menu && !header.contains(e.target)) {
      closeMenu();
    }
  });

  // Reveal once scrolled ~55% through the hero (responsive, resize-safe). Uses the
  // hero section's height rather than waiting for the whole hero to clear the viewport.
  var hero = document.getElementById('hero-sentinel');
  hero = hero ? hero.closest('section') : document.querySelector('main > section, body > section');
  var ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () {
      var trigger = hero ? hero.offsetHeight * 0.55 : 360;
      reveal(window.scrollY > trigger);
      ticking = false;
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();
</script>
