---
import Layout from '../layouts/Layout.astro';
import FloatingNav from '../components/FloatingNav.astro';
import PricingNote from '../components/PricingNote.astro';

const repoUrl = 'https://github.com/parleq/parleq-speech';

const stages = [
  {
    n: '1',
    slug: 'capture',
    title: 'Capture',
    where: 'on-device',
    grape: false,
    summary:
      'AVAudioEngine taps the system microphone at the hardware sample rate and converts each buffer in-line to 16 kHz mono Int16 — the format the local ASR model expects. Audio is accumulated as raw samples in process memory; nothing is ever written to disk.',
    detail: [
      ['Bluetooth-aware', 'When the system default input is Bluetooth, Parleq overrides to the built-in mic so your music stays in A2DP instead of dropping to HFP/SCO mid-dictation.'],
      ['Pre-warm', 'The audio unit is instantiated at app launch and a 250 ms silent capture cycle runs once after the speech model finishes loading. This pays the cold-start cost so your first real dictation isn\'t a 90 ms first-buffer stub.'],
      ['Live level meter', 'Per-buffer RMS is computed on the audio thread and pushed to the overlay so the sound-wave bars animate with your actual voice.'],
      ['Hears you — or says so', 'If the microphone stops delivering audio mid-dictation, the overlay warns you ("not hearing your mic") instead of you finding out only when nothing pastes.'],
      ['Survives device changes', 'If another app flips your input to a multi-channel format, or your audio device changes mid-dictation, Parleq rebuilds the capture on the fresh format and keeps the audio you already spoke — no more silently-empty captures. Lost one anyway (a hasty Esc, a wrong key)? Hold the hotkey and tap R to re-run your last dictation.'],
    ],
  },
  {
    n: '2',
    slug: 'transcribe',
    title: 'Transcribe',
    where: 'on-device · Apple Neural Engine',
    grape: true,
    summary:
      'The audio buffer is handed directly to Parakeet TDT v3 (CoreML) running on the Apple Neural Engine, in-process. Typical latency is ~64 ms for a 5-second clip after the model is warm. The model resides at ~150 MB and downloads from Hugging Face on first launch.',
    detail: [
      ['Custom dictionary biasing', 'Terms you\'ve added in Settings are passed to FluidAudio\'s CTC keyword-spotting + rescoring pass, which runs after the TDT transcription. Aliases for variant spellings ("parlay", "parlez") all match the canonical "Parleq" — the rescorer always emits the canonical form.'],
      ['Per-term opt-out', 'A term whose phonetics overlap a common word (and so triggers false positives at the speech-recognition layer) can be marked LLM-only. The transcribe stage skips it; the LLM hint still applies.'],
      ['Tell sound-alikes apart by voice', 'Some names sound almost exactly like an everyday word — a product called "Keavi" against the fruit "kiwi", or "Claude" against "clawed." You can optionally teach a term <em>in your own voice</em>: read a few short sentences aloud once, and Parleq learns the sound of you saying it. On later dictations it disambiguates by sound — recovering the right name, and, just as importantly, leaving the common word alone when that\'s what you actually said. Entirely on-device, no LLM, no cloud. Opt-in per term — try the interactive Voice enrollment demo on the <a href="/#explore" class="font-medium text-[color:var(--color-accent)] underline-offset-4 hover:underline">homepage explorer</a>.'],
      ['Local-only, no listening sockets', 'No cloud transcription. No per-call cost. No cold-start delay once the model has loaded. Audio bytes never leave your Mac — they aren\'t even handed across a process boundary. Parleq has no listening sockets bound on the default ASR path; reviewers can verify with `lsof -i -nP -a -p $(pgrep -n ParleqApp)`.'],
    ],
  },
  {
    n: '3',
    slug: 'cleanup',
    title: 'Clean up',
    where: 'cloud LLM · on-device · or skipped',
    grape: true,
    summary: [
      'The raw transcript streams to the AI cleanup model, which polishes it into finished text — capitalization, punctuation, filler-word removal, common transcription errors, and spoken numbers turned into digits when the context is technical. Raw shows in the overlay first; the cleaned text replaces it progressively as it arrives.',
      'You choose where that model runs. <strong class="font-semibold text-[color:var(--color-text)]">Your own cloud</strong> — Gemini, OpenAI, Bedrock, Vertex, or Azure, on your account and key — gives the strongest rewriting. <strong class="font-semibold text-[color:var(--color-text)]">On-device</strong> runs Gemma 4 E4B in-process via Apple MLX, with no network boundary and no per-call cost (one-time ~4&nbsp;GB download; 12&nbsp;GB+ RAM). Or <strong class="font-semibold text-[color:var(--color-text)]">skip cleanup</strong> entirely and paste the raw transcript exactly as the on-device speech model emitted it.',
      'Press Enter while the raw is still showing to accept it as-is; press Enter once cleanup is under way and Parleq finishes the pass and pastes the complete cleaned text — never a half-streamed fragment.',
    ],
    detail: [
      ['Pluggable providers', 'Eight options: Lightweight (a fast deterministic on-device corrector built on Concord by Keavi — no download, no RAM floor, but no free-form rewriting), On-device LLM (Gemma 4 E4B via Apple MLX — no network boundary, no per-call cost, one-time ~4 GB download, 12 GB+ RAM), Google Gemini direct API (default — free tier<sup>†</sup>, ~500–700 ms TTFT), OpenAI direct API (GPT-4o / GPT-4.1 family), Google Vertex AI (Gemini + Claude on GCP with IAM + audit logs), AWS Bedrock (Claude or GPT-OSS via your AWS account), Azure OpenAI (GPT-4o / GPT-4.1 + reasoning models on Microsoft\'s contract), or skip cleanup entirely and paste raw ASR. The choice is made in Settings or via the first-run setup wizard. For IT-deployed Macs, the provider and allowed model list can be pinned centrally via an MDM-managed configuration profile so users cannot change it.'],
      ['Auth flexibility per provider', 'Each cloud supports both pasted API keys (stored in the macOS Keychain) and your existing CLI session — gcloud Application Default Credentials for Vertex (or service-account JSON), AWS SSO / static IAM keys / scoped Bedrock API keys for Bedrock, az login or resource keys for Azure. Parleq never stores long-lived cloud session tokens directly; the AWS/GCP/Azure CLIs handle refresh through their own caches.'],
      ['Skippable', 'Re-run the setup wizard (menu bar → Run Setup…) and choose "None — skip cleanup", or set llm.provider to "none" in ~/.parleq/config.json (IT can pin it via managed configuration). The in-app Settings picker lists only real providers. Parleq will then paste the raw transcript exactly as the on-device speech model emitted it. Useful when transcript content must never leave the device.'],
      ['Custom dictionary hint', 'Your dictionary feeds a smart-vocabulary addendum to the cleanup prompt — terms with optional context blurbs and aliases. The LLM judges topic alignment and prefers your canonical spellings without force-correcting genuine homophones.'],
      ['Learns from your corrections', 'When you repeatedly fix the same name or phrase, Parleq notices. The opt-in "Learn from corrections" feature keeps short correction snippets in memory (never written to disk) and occasionally asks your already-configured cleanup model to suggest dictionary improvements — no new service, no new network destination. High-confidence spelling fixes apply automatically (and are revertible); the rest appear as suggestions to accept or dismiss.'],
      ['Catches self-corrections and spelled-out words', 'Say "scratch that", "no wait", or "I mean Rob" and Parleq drops the retracted words, keeping only your final intent (conservatively — when it can\'t tell whether you\'re correcting or listing both, it leaves your words alone). Spell a word aloud — "M I R A" — and it assembles the letters into the single word and capitalizes it correctly: a name stays a name, an acronym like URL stays all-caps. Most useful for fixing a name the speech model misheard.'],
      ['Refinement', 'When the overlay is already open, the next hotkey press re-runs this stage with a different system prompt that takes your speech as an edit instruction over the existing text. Try the interactive refine-loop demo on the <a href="/#explore" class="font-medium text-[color:var(--color-accent)] underline-offset-4 hover:underline">homepage explorer</a>.'],
    ],
  },
  {
    n: '4',
    slug: 'paste',
    title: 'Paste',
    where: 'on-device',
    grape: false,
    summary:
      'On accept (auto-timer or manual hotkey tap), the cleaned text pastes into whatever app was focused when you pressed the hotkey originally — not whatever happens to be focused at accept time. CGEventTap synthesizes the keystrokes; the trailing-space heuristic adds a space after the pasted text by default.',
    detail: [
      ['Focused-app capture', 'The original target is captured at hotkey-down. If your focus drifted while dictating, the paste still lands in the right window.'],
      ['Trailing-space override', 'Specific apps (your terminal, terminal-based editors, anything that handles its own spacing) skip the trailing space. Configurable per-app in Settings.'],
      ['Recent Dictations', 'Your recent cleaned dictations are kept in process memory and listed in the Parleq window\'s Recent Dictations section (hold the hotkey and tap P to open it). Copy any entry back to the clipboard, or paste it into the app you were just in, if a paste landed somewhere unexpected. The text is never written to disk; wiped on app quit.'],
    ],
  },
];

// The same quick reference Parleq shows in-app when you press "?" during
// a dictation. Grouped the way the help overlay groups them. The hotkey
// is named once (default: right Option) so the rows can stay generic.
const gestures = [
  {
    group: 'Dictate',
    rows: [
      ['Hold the hotkey', 'Dictate — review, then accept'],
      ['Double-tap + hold the hotkey', 'Quick dictate — pastes straight away'],
      ['Double-tap + release the hotkey', 'Hands-free recording — tap once to stop'],
    ],
  },
  {
    group: 'Refine',
    rows: [
      ['Hold the hotkey again', 'Revise the reviewed text — say what to change'],
    ],
  },
  {
    group: 'While dictating, refining, or reviewing',
    rows: [
      ['Space', 'Attach another window as context'],
      ['C', 'Attach the current window as context'],
      ['P', 'Cancel and show the Parleq window'],
      ['Hold the hotkey + R', 'Recover your last dictation — re-runs it (also in the menu bar)'],
      ['? or /', 'Show this help'],
    ],
  },
  {
    group: 'Reviewing your text',
    rows: [
      ['Enter', 'Accept & paste to the current app'],
      ['E', 'Edit the text yourself before accepting'],
      ['V', 'Send to a different window'],
    ],
  },
];
---

<Layout
  title="The details — how Parleq works"
  description="The technical detail behind Parleq: the capture → transcribe → clean up → paste pipeline, the keyboard gestures, and exactly what's written to disk versus held in memory."
>
  <FloatingNav active="how-it-works" spacer={false} />

  <!-- Hero: LIGHT-lavender "utility / reference" hero (docs family), NOT the deep-grape
       marquee — the deep hero is reserved for the homepage so it stands out. Dark text +
       grape accent (amber fails AA on the light-purple ground). Nav pill floats over it. -->
  <section class="mx-auto max-w-[1700px] px-0 py-0 sm:px-5 sm:py-5">
    <div
      class="relative overflow-hidden rounded-none px-5 pb-28 pt-28 sm:rounded-[28px] sm:px-10 sm:pt-36"
      style="background: linear-gradient(180deg, var(--color-hero-light-top) 0%, var(--color-hero-light-bottom) 100%);"
    >
      <div class="mx-auto grid max-w-5xl items-center gap-10 lg:grid-cols-[1.35fr_1fr] lg:gap-14">
        <div>
          <p class="text-sm font-medium uppercase tracking-[0.18em] text-[color:var(--color-grape)]">
            How it works
          </p>
          <h1 class="mt-4 font-display text-4xl leading-[1.05] font-medium tracking-tight sm:text-5xl md:text-6xl">
            The details, stage by stage.
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-[color:var(--color-text-muted)] sm:text-xl">
            How a dictation goes from keypress to pasted text — capture, transcribe, clean up, paste. Speech recognition stays on your Mac; only cleanup can reach the network, and only if you choose a cloud provider.
          </p>
          <p class="mt-6 text-sm">
            <a href="#gestures" class="font-medium text-[color:var(--color-grape)] underline-offset-4 hover:underline">Just want the keyboard gestures? Jump to the cheat sheet →</a>
          </p>
        </div>

        <!-- Guided-tour fork: the interactive explorer on the homepage, for visitors who
             want the tour rather than the mechanics. In the hero so the choice is up front. -->
        <a
          href="/#explore"
          class="group block rounded-2xl border border-[color:var(--color-grape-200)]/60 bg-[color:var(--color-surface)] p-6 shadow-[0_10px_30px_-18px_rgba(67,32,95,0.35)] transition duration-300 hover:border-[color:var(--color-grape)] hover:shadow-[0_22px_50px_-24px_rgba(67,32,95,0.45)]"
        >
          <div class="flex items-center gap-4">
            <svg class="h-20 w-16 shrink-0 transition-transform duration-300 group-hover:-translate-y-1" viewBox="0 0 112 152" fill="none" aria-hidden="true">
              <defs>
                <radialGradient id="hwGrapeLite" cx="36%" cy="28%" r="80%">
                  <stop offset="0%" stop-color="#9a5fc9" />
                  <stop offset="52%" stop-color="#5b2a86" />
                  <stop offset="100%" stop-color="#331652" />
                </radialGradient>
              </defs>
              <path d="M56 6c2 6 1 11 3 17" stroke="#8a6a3a" stroke-width="2.4" stroke-linecap="round" />
              <path d="M58 12c5-8 17-10 23-6-3 8-12 12-21 11" fill="#5f9d4c" opacity="0.9" />
              <g stroke="#2a1046" stroke-opacity="0.4" stroke-width="1">
                <circle cx="38" cy="34" r="14" fill="url(#hwGrapeLite)" />
                <circle cx="64" cy="30" r="15" fill="url(#hwGrapeLite)" />
                <circle cx="89" cy="35" r="13" fill="url(#hwGrapeLite)" />
                <circle cx="27" cy="56" r="13" fill="url(#hwGrapeLite)" />
                <circle cx="52" cy="54" r="15" fill="url(#hwGrapeLite)" />
                <circle cx="77" cy="55" r="14" fill="url(#hwGrapeLite)" />
                <circle cx="99" cy="59" r="11" fill="url(#hwGrapeLite)" />
                <circle cx="40" cy="76" r="14" fill="url(#hwGrapeLite)" />
                <circle cx="66" cy="76" r="15" fill="url(#hwGrapeLite)" />
                <circle cx="90" cy="79" r="12" fill="url(#hwGrapeLite)" />
                <circle cx="53" cy="97" r="14" fill="url(#hwGrapeLite)" />
                <circle cx="78" cy="97" r="13" fill="url(#hwGrapeLite)" />
                <circle cx="64" cy="117" r="14" fill="url(#hwGrapeLite)" />
                <circle cx="57" cy="137" r="12" fill="url(#hwGrapeLite)" />
              </g>
              <g fill="#f0e2ff" opacity="0.55">
                <circle cx="34" cy="30" r="3" />
                <circle cx="60" cy="26" r="3.2" />
                <circle cx="48" cy="50" r="3" />
                <circle cx="62" cy="72" r="3.2" />
                <circle cx="60" cy="113" r="2.8" />
              </g>
            </svg>
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.16em] text-[color:var(--color-grape)]">Every capability</p>
              <p class="mt-1 font-display text-xl font-medium leading-tight text-[color:var(--color-text)]">Prefer a guided tour?</p>
            </div>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-[color:var(--color-text-muted)]">Every feature — cleanup, refine &amp; shape, the whole flow — is an interactive demo you drive on the homepage.</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--color-grape)] underline-offset-4 group-hover:underline">Open the explorer →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Content panel: a white card superimposed on the grape hero (rounded top, bordered
       bottom, shadow onto the grape). Opens straight into the technical pipeline;
       supplementary sections (gestures, privacy) follow below it. -->
  <div class="mx-auto max-w-[1700px] px-0 sm:px-5">
    <div class="relative z-10 -mt-14 border border-[color:var(--color-grape-200)]/50 bg-[color:var(--color-surface)] px-3 pb-10 pt-3 shadow-[0_18px_50px_-18px_rgba(67,32,95,.35)] sm:-mt-16 sm:rounded-t-[28px] sm:px-10 sm:pb-12 sm:pt-6">

  <!-- Pipeline stepper. The example-flow strip (Audio → Transcript →
       Cleaned → Pasted) is now the STAGE NAVIGATION: each box is a
       button that activates the matching stage panel below (Audio↔1
       Capture, Transcript↔2 Transcribe, Cleaned↔3 Clean up, Pasted↔4
       Paste). Below it, one stage panel shows at a time.

       Progressive enhancement: the server renders all four panels
       VISIBLE and stacked (today's reading experience) and the nav
       boxes as plain links to the panel anchors. The inline script at
       the bottom upgrades this into a swap-pager — it hides inactive
       panels, turns the nav links into aria-current buttons, wires
       prev/next, and syncs the location.hash via replaceState. A no-JS
       visitor keeps the full stacked page. A11y: plain
       buttons-with-aria-current pattern (matching the homepage
       carousel), not the APG tabs pattern. -->
  <section data-reveal class="mx-auto max-w-4xl px-6 pb-4 pt-10">
    <div
      id="pipeline-stepper"
      class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-6 sm:p-8"
    >
      <p class="text-xs font-medium uppercase tracking-[0.16em] text-[color:var(--color-text-subtle)]">
        The pipeline
      </p>

      <!-- Stage navigation: the data-transformation strip. Each box maps
           1:1 to a stage panel below. Server-rendered as anchor links
           (no-JS deep jump to the visible panel); the script swaps them
           to buttons that page between panels. The mono example utterance
           gives the reader something concrete to pin each stage to. -->
      <nav
        id="stepper-nav"
        aria-label="Pipeline stages"
        class="mt-4 grid gap-4 text-sm sm:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr] sm:items-center sm:gap-3"
      >
        <a
          href="#stage-capture"
          data-stage-nav="0"
          class="stepper-box rounded-lg border border-[color:var(--color-border-subtle)] bg-[color:var(--color-bg)] p-3 text-left transition-colors hover:border-[color:var(--color-accent)]"
        >
          <p class="text-[10px] font-medium uppercase tracking-wider text-[color:var(--color-text-subtle)]">1 · Audio</p>
          <p class="mt-1 font-mono text-[12px] text-[color:var(--color-text-muted)]">~3 s WAV<br/>16 kHz mono</p>
        </a>
        <span class="hidden text-[color:var(--color-text-subtle)] sm:inline" aria-hidden="true">→</span>

        <a
          href="#stage-transcribe"
          data-stage-nav="1"
          class="stepper-box rounded-lg border border-[color:var(--color-border-subtle)] bg-[color:var(--color-bg)] p-3 text-left transition-colors hover:border-[color:var(--color-accent)]"
        >
          <p class="text-[10px] font-medium uppercase tracking-wider text-[color:var(--color-text-subtle)]">2 · Transcript</p>
          <p class="mt-1 font-mono text-[12px] text-[color:var(--color-text)]">"lets go to the beach this weekend"</p>
        </a>
        <span class="hidden text-[color:var(--color-text-subtle)] sm:inline" aria-hidden="true">→</span>

        <a
          href="#stage-cleanup"
          data-stage-nav="2"
          class="stepper-box rounded-lg border border-[color:var(--color-border-subtle)] bg-[color:var(--color-bg)] p-3 text-left transition-colors hover:border-[color:var(--color-accent)]"
        >
          <p class="text-[10px] font-medium uppercase tracking-wider text-[color:var(--color-text-subtle)]">3 · Cleaned</p>
          <p class="mt-1 font-mono text-[12px] text-[color:var(--color-text)]">"Let's go to the beach this weekend."</p>
        </a>
        <span class="hidden text-[color:var(--color-text-subtle)] sm:inline" aria-hidden="true">→</span>

        <a
          href="#stage-paste"
          data-stage-nav="3"
          class="stepper-box rounded-lg border border-[color:var(--color-accent-soft)] bg-[color:var(--color-accent-soft)]/30 p-3 text-left transition-colors"
        >
          <p class="text-[10px] font-medium uppercase tracking-wider text-[color:var(--color-accent)]">4 · Pasted</p>
          <p class="mt-1 font-mono text-[12px] text-[color:var(--color-text)]">into the focused app</p>
        </a>
      </nav>

      <!-- Visually-hidden polite live region: announces the active stage
           name when the script swaps panels, so screen-reader users hear
           that new content rendered (the activating control keeps focus).
           Same pattern as the homepage carousel's announce region. -->
      <div id="stepper-announce" class="sr-only" aria-live="polite"></div>

      <!-- Stage panels. All four are server-rendered VISIBLE and stacked
           below the strip — that's the no-JS reading experience. The
           script hides the inactive ones and pages between them. Each
           panel = the old stage card (big serif number, title, where-chip,
           summary, then the detail rows as native <details> accordions). -->
      <div id="stepper-panels" class="mt-8 space-y-12 sm:space-y-16">
        {stages.map((stage, i) => (
          <article
            id={`stage-${stage.slug}`}
            class="stepper-panel scroll-mt-20"
            data-stage-panel={String(i)}
          >
            <div class="grid gap-6 sm:grid-cols-[auto_1fr] sm:gap-8">
              <div class={`font-display text-5xl font-semibold tabular-nums leading-none sm:text-6xl ${stage.grape ? 'text-[color:var(--color-grape)]' : 'text-[color:var(--color-accent)]'}`}>
                {stage.n}
              </div>
              <div>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h2 class="font-display text-2xl font-semibold tracking-tight sm:text-3xl">
                    {stage.title}
                  </h2>
                  <span class={`font-mono text-xs uppercase tracking-wider ${stage.grape ? 'text-[color:var(--color-grape)]' : 'text-[color:var(--color-text-subtle)]'}`}>
                    {stage.where}
                  </span>
                </div>
                {(Array.isArray(stage.summary) ? stage.summary : [stage.summary]).map((para) => (
                  <p class="mt-4 leading-relaxed text-[color:var(--color-text-muted)]" set:html={para}></p>
                ))}
                <!-- Detail rows as native <details>/<summary> accordions,
                     closed by default. Native because Chromium auto-expands
                     them on find-in-page — a reimplemented accordion would
                     hide matches from Ctrl-F. -->
                <div class={`mt-6 space-y-2 border-l pl-5 ${stage.grape ? 'border-[color:var(--color-grape-200)]' : 'border-[color:var(--color-border)]'}`}>
                  {stage.detail.map(([term, body]) => (
                    <details class="stage-detail group">
                      <summary class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-[color:var(--color-text)]">
                        <svg
                          aria-hidden="true"
                          class={`stage-detail-chevron h-3.5 w-3.5 shrink-0 transition-transform ${stage.grape ? 'text-[color:var(--color-grape)]' : 'text-[color:var(--color-accent)]'}`}
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="m9 18 6-6-6-6" />
                        </svg>
                        <span>{term}</span>
                      </summary>
                      <div class="mt-1 pl-[1.375rem] text-[15px] leading-relaxed text-[color:var(--color-text-muted)]" set:html={body}>
                      </div>
                    </details>
                  ))}
                </div>
              </div>
            </div>

            <!-- Per-panel prev/next pager controls. Hidden until the
                 script enables paging (no-JS visitors read the stacked
                 panels top-to-bottom, so these would be redundant). -->
            <div class="stepper-pager mt-8 hidden items-center justify-between gap-4 sm:pl-[calc(3.75rem+2rem)]">
              <button
                type="button"
                data-stepper-prev
                class="inline-flex items-center gap-1.5 rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)] px-3.5 py-1.5 text-[13px] font-medium text-[color:var(--color-text-muted)] transition-colors hover:border-[color:var(--color-text-muted)] hover:text-[color:var(--color-text)] disabled:cursor-not-allowed disabled:opacity-40"
              >
                <span aria-hidden="true">‹</span>
                <span data-stepper-prev-label>Previous stage</span>
              </button>
              <button
                type="button"
                data-stepper-next
                class="inline-flex items-center gap-1.5 rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)] px-3.5 py-1.5 text-[13px] font-medium text-[color:var(--color-text-muted)] transition-colors hover:border-[color:var(--color-text-muted)] hover:text-[color:var(--color-text)] disabled:cursor-not-allowed disabled:opacity-40"
              >
                <span data-stepper-next-label>Next stage</span>
                <span aria-hidden="true">›</span>
              </button>
            </div>
          </article>
        ))}
      </div>
      <div class="mx-auto max-w-3xl px-6">
        <PricingNote />
      </div>
    </div>
  </section>

    </div>
  </div>
  <!-- end content panel -->

  <!-- Keyboard gestures: the same quick reference the in-app "?" help
       overlay shows, grouped the same way. Placed high with its own
       anchor (#gestures) so it's reachable in a single jump, for
       readers who'd otherwise get lost in the verbose stage cards. -->
  <section id="gestures" data-reveal class="scroll-mt-20 border-t border-[color:var(--color-border-subtle)] bg-[color:var(--color-section-tint)]">
    <div class="mx-auto max-w-4xl px-6 py-20">
