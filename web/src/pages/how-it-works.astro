  <!-- Reveal-on-scroll + pipeline-stepper behavior. is:inline so it
       runs immediately (it touches only this page's DOM, needs no
       bundling, and must apply .reveal before first paint of the
       below-the-fold sections). The reveal block is copied verbatim
       from the homepage so the reduced-motion no-op ordering and the
       same-frame fix for already-in-view elements stay identical. -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Reveal-on-scroll. If the visitor prefers reduced motion we do
      // NOTHING — content stays fully visible, never gets .reveal. This
      // ordering matters: applying .reveal first would hide content for
      // a reduced-motion user.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const targets = document.querySelectorAll('[data-reveal]');
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-visible');
                obs.unobserve(entry.target); // once-only
              }
            });
          },
          { threshold: 0, rootMargin: '0px' }
        );
        // Hide only elements that start BELOW the viewport: anything
        // already in view on load keeps both classes in the same frame
        // (no one-frame blank flash); the observer's async first
        // callback then no-ops on them via the once-only unobserve.
        targets.forEach((el) => {
          el.classList.add('reveal');
          if (el.getBoundingClientRect().top < window.innerHeight) {
            el.classList.add('reveal-visible');
          }
          observer.observe(el);
        });
      }

      // Pipeline stepper. Progressive enhancement over the server-
      // rendered stacked panels: hide all but one, mark the active nav
      // anchor with aria-current and page between panels on click, wire
      // each panel's prev/next pager, and keep the location.hash in sync
      // (replaceState, no scroll jump). No-JS visitors keep the full
      // stacked page untouched.
      const stepper = document.getElementById('pipeline-stepper');
      const navBoxes = stepper
        ? Array.from(stepper.querySelectorAll('[data-stage-nav]'))
        : [];
      const panels = stepper
        ? Array.from(stepper.querySelectorAll('[data-stage-panel]'))
        : [];
      if (stepper && navBoxes.length > 0 && navBoxes.length === panels.length) {
        const N = panels.length;
        const announce = document.getElementById('stepper-announce');
        // Suppresses the announcement on the initial go() at load, so a
        // plain page visit doesn't fire an unsolicited screen-reader read.
        let initialized = false;

        // Per-stage label "N Title" for the prev/next controls, pulled
        // from each panel's serif number + heading so the script needs
        // no duplicated copy.
        const labels = panels.map((panel) => {
          const num = panel.querySelector('.font-display.tabular-nums');
          const title = panel.querySelector('h2');
          const n = num ? num.textContent.trim() : '';
          const t = title ? title.textContent.trim() : '';
          return (n + ' ' + t).trim();
        });
        const slugs = panels.map((panel) => (panel.id || '').replace(/^stage-/, ''));

        // The nav boxes stay native <a> elements pointing at the panel
        // anchors — fully accessible as-is (Enter + click activate, the
        // href stays in the a11y tree, aria-current marks the active
        // one). We don't promote them to role="button" (that ARIA
        // anti-pattern would mask the href and demand a hand-rolled
        // Space contract). We only intercept the click to page in place
        // instead of taking the native jump-to-anchor scroll.
        navBoxes.forEach((box, i) => {
          box.addEventListener('click', (e) => {
            e.preventDefault();
            go(i, true);
          });
        });

        // Pager buttons live inside each panel; reveal the row (it ships
        // hidden so no-JS readers don't see dead controls) and wire it.
        panels.forEach((panel, i) => {
          const pager = panel.querySelector('.stepper-pager');
          if (pager) {
            pager.classList.remove('hidden');
            pager.classList.add('flex');
          }
          const prev = panel.querySelector('[data-stepper-prev]');
          const next = panel.querySelector('[data-stepper-next]');
          // Pass the click direction so go() can move focus into the
          // newly-shown panel's matching pager button — the clicked
          // button is about to be hidden (its panel hides), so without
          // this, focus would fall back to <body> and lose the keyboard
          // user's place.
          if (prev) prev.addEventListener('click', () => go(i - 1, true, 'prev'));
          if (next) next.addEventListener('click', () => go(i + 1, true, 'next'));
        });

        function go(i, updateHash, focusHint) {
          // Clamp, don't wrap: a linear pipeline has dead ends at stage
          // 1 and stage N, so the terminal pager buttons disable rather
          // than loop. (The nav strip can still jump to any stage.)
          const index = Math.max(0, Math.min(N - 1, i));
          panels.forEach((panel, j) => {
            if (j === index) {
              panel.removeAttribute('hidden');
            } else {
              panel.setAttribute('hidden', '');
            }
          });
          navBoxes.forEach((box, j) => {
            if (j === index) {
              // "step" is the semantic token for the current item in a
              // step/stage sequence; CSS keys the active style off it.
              box.setAttribute('aria-current', 'step');
            } else {
              box.removeAttribute('aria-current');
            }
          });
          // Prev/next labels + disabled state for the active panel's
          // pager. At a boundary the terminal button is disabled (its
          // disabled: styling then applies) and keeps the current
          // stage's label rather than pointing at a nonexistent step.
          const active = panels[index];
          const prevBtn = active.querySelector('[data-stepper-prev]');
          const nextBtn = active.querySelector('[data-stepper-next]');
          const prevLabel = active.querySelector('[data-stepper-prev-label]');
          const nextLabel = active.querySelector('[data-stepper-next-label]');
          const atStart = index === 0;
          const atEnd = index === N - 1;
          if (prevBtn) prevBtn.disabled = atStart;
          if (nextBtn) nextBtn.disabled = atEnd;
          if (prevLabel) prevLabel.textContent = labels[atStart ? index : index - 1];
          if (nextLabel) nextLabel.textContent = labels[atEnd ? index : index + 1];

          // Restore focus into the new panel for keyboard pager users.
          // Prefer the button matching the direction just clicked; if it
          // landed disabled (a boundary), fall back to the still-enabled
          // sibling so focus never gets dropped onto <body>.
          if (focusHint === 'prev' || focusHint === 'next') {
            const wanted = focusHint === 'prev' ? prevBtn : nextBtn;
            const sibling = focusHint === 'prev' ? nextBtn : prevBtn;
            const target = wanted && !wanted.disabled ? wanted : sibling;
            if (target && !target.disabled) target.focus();
          }

          if (updateHash && slugs[index]) {
            // replaceState keeps the URL shareable without adding a
            // history entry per click and without the scroll jump a
            // raw hash assignment would trigger.
            history.replaceState(null, '', '#stage-' + slugs[index]);
          }

          // Announce the now-visible stage to AT — but only on real
          // swaps, not the initial load paint.
          if (announce && initialized) {
            announce.textContent = labels[index];
          }
        }

        // Initial stage: honor a matching deep-link hash, else stage 1.
        // Don't rewrite the hash on load (updateHash=false) so a plain
        // /how-it-works visit keeps a clean URL.
        const hash = (location.hash || '').replace(/^#/, '');
        let initial = 0;
        const hashIdx = slugs.indexOf(hash.replace(/^stage-/, ''));
        if (hash.startsWith('stage-') && hashIdx !== -1) initial = hashIdx;
        go(initial, false);
        // From here on, swaps announce; the initial paint above did not.
        initialized = true;
      }
    });
  </script>

</Layout>
