---
import Layout from '../layouts/Layout.astro';
import TransformCard from '../components/TransformCard.astro';
import ConcordFlow from '../components/ConcordFlow.astro';
import GrapeExplorer from '../components/GrapeExplorer.astro';
import FloatingNav from '../components/FloatingNav.astro';
import { fetchLatestRelease } from '../lib/release';

const release = await fetchLatestRelease();
const releasesUrl = release.releasePageUrl;
const repoUrl = 'https://github.com/parleq/parleq-speech';

// Direct .dmg URL when the release fetch succeeded; falls back to
// the Releases page URL if the API was unreachable. Either way the
// CTA still works — tester just sees the page instead of a direct
// download in the fallback case.
const downloadUrl = release.downloadUrl;

// JSON-LD: SoftwareApplication schema for search rich results.
// Static fields only — release-specific values would go stale in
// search caches between releases anyway.
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Parleq',
  operatingSystem: 'macOS 14 or later (Apple Silicon)',
  applicationCategory: 'UtilitiesApplication',
  description:
    'Local-first AI dictation for macOS. Press a hotkey, speak, and watch your words appear cleaned up — speech recognition runs on-device, audio never leaves your Mac.',
  url: 'https://parleq.app/',
  downloadUrl: `${repoUrl}/releases/latest`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

// Base path for in-page/how-it-works deep links used below.
const base = `${import.meta.env.BASE_URL}`.replace(/\/$/, '');
---

<Layout title="Parleq — Local-first AI dictation for macOS">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(softwareSchema)} />
  <FloatingNav downloadUrl={downloadUrl} active="home" spacer={false} />
  <!-- Hero: framed dark-grape panel + ConcordFlow art (Beat 1). The nav is the shared
       FloatingNav pill (fixed, floats over this panel); the panel's top padding clears it
       and gives airy space below the pill. Responsive frame: content grows with the window
       (cap 1700px), ~20px desktop margin, FULL-BLEED on mobile (margin → 0, no rounding). -->
  <section class="mx-auto max-w-[1700px] px-0 py-0 sm:px-5 sm:py-5">
    <div
      class="relative overflow-hidden rounded-none px-5 pb-28 pt-28 sm:rounded-[28px] sm:px-10 sm:pt-36"
      style="background:
               radial-gradient(58% 74% at 72% 52%, color-mix(in srgb, var(--color-grape-600) 55%, transparent), transparent 68%),
               linear-gradient(180deg, #1d0b33 0%, #140622 100%);
             box-shadow: 0 30px 80px -30px rgba(20,7,32,.7);"
    >
      <div class="relative grid items-center gap-10 lg:grid-cols-[40%_60%]">
        <!-- LEFT column: copy, CTAs, feature chips -->
        <div>
          <!-- Audio privacy pill (load-bearing required string). -->
          <span class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium" style="border-color: color-mix(in srgb, var(--color-grape-300) 35%, transparent); color: var(--color-grape-200); background: color-mix(in srgb, var(--color-grape-500) 20%, transparent);">
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
            Your voice never leaves your Mac
          </span>

          <!-- Semantic h1: carries the message for screen readers; the flow art is aria-hidden. -->
          <h1 class="font-display mt-6 text-5xl font-medium leading-[1.02] tracking-tight sm:text-6xl" style="color: var(--color-panel-ink);">
            Speak freely.<br /><span style="color: var(--color-grape-300);">Paste clean.</span>
          </h1>

          <p class="mt-6 max-w-md text-base leading-relaxed" style="color: color-mix(in srgb, var(--color-panel-ink) 80%, transparent);">
            <span style="color: var(--color-panel-ink);">Parleq</span> <span class="font-mono text-xs" style="color: var(--color-grape-200);">/PAR-lek/</span> is a local-first AI dictation app for macOS. Hold a hotkey and talk; the cleaned-up result pastes into whatever app was focused — speech recognition and cleanup can both run on your Mac, or use the cloud you bring.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href={downloadUrl}
              data-goatcounter-click="download-hero"
              class="cta-solid inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm"
            >
              Download for macOS{release.version && ` ${release.version}`}
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v11M8 11l4 4 4-4M5 20h14"></path></svg>
            </a>
            <a href="#explore" class="inline-flex items-center gap-2 rounded-full border px-6 py-3 text-sm font-semibold" style="border-color: color-mix(in srgb, var(--color-grape-300) 35%, transparent); color: var(--color-grape-100);">
              See it in action
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
            </a>
          </div>

          <p class="mt-4 text-xs" style="color: color-mix(in srgb, var(--color-grape-200) 60%, transparent);">
            Apache-2.0 · macOS 14+ · Apple Silicon required
          </p>

          <div class="mt-5 flex flex-wrap gap-2">
            <span class="chip-d">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg>
              Voiceprints
            </span>
            <span class="chip-d">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z"></path></svg>
              On-device cleanup
            </span>
            <span class="chip-d">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3 7 21M17 3l-2 18M4 8h16M3 16h16"></path></svg>
              Numbers &amp; punctuation
            </span>
            <span class="chip-d">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2zM6 17h12"></path></svg>
              Custom dictionary
            </span>
          </div>
        </div>

        <!-- RIGHT: ConcordFlow SVG art + three TransformCards (decorative; h1 carries the message). -->
        <!-- Flow art uses fixed-position cards sized for the 560px stage; below md it can't
             scale without overlapping, so it's hidden on small screens (decorative — the h1 +
             subhead carry the message). A simplified mobile treatment is a follow-up. -->
        <div class="relative mx-auto hidden h-[360px] w-full max-w-[560px] md:block" aria-hidden="true">
          <ConcordFlow uid="hero" />
          <TransformCard
            variant="input"
            title="You speak"
            lines={[
              {text: 'so we processed <span class="u-tok">eight point nine</span> million rows. did the build pass and is it ready to ship?'},
              {text: 'the <span class="u-tok">parlay</span> docs are live. shipped some updates to <span class="u-tok">kiwi</span>.'}
            ]}
          />
          <TransformCard
            variant="engine"
            items={["Punctuation","Numbers","Voiceprints","Dictionary"]}
            credit="built on Concord (by Keavi)"
          />
          <TransformCard
            variant="output"
            title="Parleq pastes"
            lines={[
              {text: 'We processed <span class="mk-tok">8.9 million</span> rows. Did the build pass and is it ready to ship?'},
              {text: 'The <span class="mk-tok">Parleq</span> docs are live. Shipped some updates to <span class="mk-tok">Keavi</span>.'}
            ]}
          >
            <div class="mt-3 inline-flex items-center gap-1.5 text-[10px] font-medium" style="color:#7fd99a;">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"></path></svg>
              Pasted
            </div>
          </TransformCard>
        </div>
      </div>
    </div>
  </section>

  <!-- Vine explorer: the interactive capability bunch (Cleanup + Refine families).
       First white section SUPERIMPOSED on the hero (the "card on purple" transition,
       same max-width frame). Neutral light card (NOT zone-grape): the bunch spans
       on-device AND cloud grapes, so privacy is scoped PER GRAPE via the demo chip —
       no section-wide "on-device" theming or blanket claim. -->
  <div class="mx-auto max-w-[1700px] px-0 sm:px-5">
    <section id="explore" data-reveal class="relative z-10 -mt-16 scroll-mt-20 rounded-none bg-[color:var(--color-bg)] px-6 py-20 shadow-[0_18px_70px_-16px_rgba(8,3,18,.6)] sm:rounded-t-[28px] sm:px-10 sm:py-24">
      <div class="mx-auto max-w-5xl">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-[color:var(--color-grape)]">
        What Parleq does
      </p>
      <h2 class="mt-4 font-display text-3xl leading-[1.1] font-medium tracking-tight sm:text-4xl">
        Not one trick. A whole toolkit.
      </h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-[color:var(--color-text-muted)]">
        Between the hotkey and the paste, a set of small, sharp corrections each do one thing well — punctuation, numbers, your names, a cloud rewrite when you want one. Switch families and click any one to watch it work. <span class="text-[color:var(--color-text-subtle)]">Cleanup runs on your Mac; refine hands off to the AI you bring.</span>
      </p>

      <GrapeExplorer />

      <!-- Per-app "moment": the right cleanup per app. INCLUDED PRESENT-TENSE per the
           maintainer decision (2026-06-30) — this BINDS THE RELEASE GATE: the site must
           ship together with a RUNTIME-COMPLETE per-target-cleanup feature (config-model
           only today). App-defaults card; Instant = on-device (green), Polished = the
           provider you set (grape). No destination-routing implication — Parleq applies
           the cleanup you set per app; the private routing vision stays private. -->
      <section class="perapp mt-28 grid items-center gap-x-12 gap-y-8 lg:grid-cols-[320px_minmax(0,1fr)]">
        <div>
          <p class="text-sm font-medium uppercase tracking-[0.18em] text-[color:var(--color-accent)]">Per-app cleanup</p>
          <h2 class="mt-3 font-display text-3xl font-medium tracking-tight sm:text-4xl">The right cleanup for every app.</h2>
          <p class="mt-4 max-w-md text-[15px] leading-relaxed text-[color:var(--color-text-muted)]">
            Set which cleanup each app gets — <strong class="font-semibold text-[color:var(--color-text)]">instant</strong> on your Mac for a terminal, <strong class="font-semibold text-[color:var(--color-text)]">polished</strong> for email and chat. Parleq remembers, per app.
          </p>
          <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[color:var(--color-text-subtle)]">
            <span class="inline-flex items-center gap-1.5"><span class="pa-dot pa-dot-instant"></span>Instant — on-device</span>
            <span class="inline-flex items-center gap-1.5"><span class="pa-dot pa-dot-polished"></span>Polished — the provider you set</span>
          </p>
        </div>

        <div class="pa-card w-full max-w-md justify-self-center lg:justify-self-start">
          <p class="pa-card-head">App defaults</p>
          <ul class="pa-list">
            <li class="pa-row"><span class="pa-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 10 3 2-3 2"/><path d="M13 14h4"/></svg></span><span class="pa-name">Terminal</span><span class="pa-chip pa-chip-instant">Instant</span></li>
            <li class="pa-row"><span class="pa-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m9 8-4 4 4 4"/><path d="m15 8 4 4-4 4"/></svg></span><span class="pa-name">Code editor</span><span class="pa-chip pa-chip-instant">Instant</span></li>
            <li class="pa-row"><span class="pa-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span><span class="pa-name">Mail</span><span class="pa-chip pa-chip-polished">Polished</span></li>
            <li class="pa-row"><span class="pa-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-8.5 8.5 8.6 8.6 0 0 1-3.9-.9L3 21l1.9-5.6A8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5Z"/></svg></span><span class="pa-name">Slack</span><span class="pa-chip pa-chip-polished">Polished</span></li>
            <li class="pa-row"><span class="pa-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h8l4 4v16H6z"/><path d="M14 2v4h4"/><path d="M9 13h6M9 17h6"/></svg></span><span class="pa-name">Notes</span><span class="pa-chip pa-chip-polished">Polished</span></li>
          </ul>
        </div>
      </section>
      </div>
    </section>
  </div>

  <!-- Trust band: "your machine, your rules." Homes the audit orphans that
       aren't per-utterance transforms (so they aren't grapes): on-device ASR
       (audio never leaves), provider breadth + no-server trust, never-lose-a-
       dictation (small overlay mockup), and compliance-by-default (→ /enterprise).
       ACCURACY: no blanket "everything is local" — AUDIO never leaves, but
       cleanup TEXT may go to the cloud provider the user brings. -->
  <section data-reveal class="border-t border-[color:var(--color-border-subtle)]" style="background: color-mix(in srgb, var(--color-grape) 3%, var(--color-bg));">
    <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-[color:var(--color-grape)]">
        Privacy &amp; control
      </p>
      <h2 class="mt-4 font-display text-3xl leading-[1.1] font-medium tracking-tight sm:text-4xl">
        Your machine, your rules.
      </h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[color:var(--color-text-muted)]">
        Speech recognition runs on your Mac, and your audio never leaves it. Cleanup runs on-device too — or through your own cloud account, if you bring one. Keavi runs no server and is never in the data path.
      </p>

      <div class="mt-12 grid items-start gap-x-12 gap-y-12 lg:grid-cols-2">
        <!-- Left: trust points -->
        <ul class="space-y-8">
          <li class="flex gap-4">
            <span aria-hidden="true" class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[color:var(--color-border-subtle)] bg-[color:var(--color-surface)] text-[color:var(--color-grape)]">
              <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M6 11a6 6 0 0 0 12 0"/><path d="M12 17v4M9 21h6"/></svg>
            </span>
            <div>
              <h3 class="text-[15px] font-semibold tracking-tight text-[color:var(--color-text)]">Your audio never leaves your Mac.</h3>
              <p class="mt-1.5 text-[14px] leading-relaxed text-[color:var(--color-text-muted)]">Parakeet speech recognition runs on the Apple Neural Engine. Audio lives in memory for the length of a dictation — never written to disk, never sent anywhere.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span aria-hidden="true" class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[color:var(--color-border-subtle)] bg-[color:var(--color-surface)] text-[color:var(--color-grape)]">
              <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="7" width="10" height="10" rx="1.5"/><path d="M10 4v3M14 4v3M10 17v3M14 17v3M4 10h3M4 14h3M17 10h3M17 14h3"/></svg>
            </span>
            <div>
              <h3 class="text-[15px] font-semibold tracking-tight text-[color:var(--color-text)]">Bring your own AI — or none.</h3>
              <p class="mt-1.5 text-[14px] leading-relaxed text-[color:var(--color-text-muted)]">Cleanup runs on-device, or through your own <strong class="font-medium text-[color:var(--color-text)]">Gemini, OpenAI, Bedrock, Vertex, or Azure</strong> account. Your keys, your data path — Parleq just talks to the endpoint you configured.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span aria-hidden="true" class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[color:var(--color-border-subtle)] bg-[color:var(--color-surface)] text-[color:var(--color-grape)]">
              <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.2 2.9 7.8 7 9 4.1-1.2 7-4.8 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <div>
              <h3 class="text-[15px] font-semibold tracking-tight text-[color:var(--color-text)]">Compliance-friendly by default.</h3>
              <p class="mt-1.5 text-[14px] leading-relaxed text-[color:var(--color-text-muted)]">Audio stays in memory, logs are metrics-only, secrets live in the Keychain, and dictation fails closed when you sign out. <a href={`${base}/enterprise/`} class="font-medium text-[color:var(--color-accent-hover)] underline-offset-4 hover:underline">More for IT teams →</a></p>
            </div>
          </li>
        </ul>

        <!-- Right: "never lose a dictation" overlay mockup -->
        <div class="justify-self-center lg:justify-self-end lg:mt-2">
          <div class="w-full max-w-sm rounded-2xl border p-5 shadow-[0_22px_60px_-34px_rgba(20,7,32,.55)]" style="background: linear-gradient(180deg, #1c2128, #171c22); border-color: rgba(255,255,255,.1);">
            <div class="flex items-center gap-3">
              <span aria-hidden="true" class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg" style="background: color-mix(in srgb, var(--color-accent) 22%, transparent); color: #fcd9a3;">
                <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m2 2 20 20"/><path d="M9 9v3a3 3 0 0 0 5 2.2"/><path d="M15 9.3V5a3 3 0 0 0-5.7-1.3"/><path d="M6 11a6 6 0 0 0 9 5.2"/><path d="M12 17v4M9 21h6"/></svg>
              </span>
              <div>
                <p class="text-sm font-semibold text-white">Mic went quiet mid-sentence</p>
                <p class="text-xs" style="color: rgba(255,255,255,.55);">Parleq kept what you said.</p>
              </div>
            </div>
            <div class="mt-4 flex items-center gap-2.5 border-t pt-3.5" style="border-color: rgba(255,255,255,.1);">
              <span class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs font-semibold text-white" style="background: var(--color-accent-hover);">
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v4h4"/></svg>
                Re-run
              </span>
              <span class="text-xs" style="color: rgba(255,255,255,.42);">press <kbd class="rounded border px-1 font-mono" style="border-color: rgba(255,255,255,.2);">R</kbd></span>
            </div>
          </div>
          <p class="mt-4 max-w-sm text-[14px] leading-relaxed text-[color:var(--color-text-muted)]">
            <strong class="font-semibold text-[color:var(--color-text)]">Never lose a dictation.</strong> If your mic drops or your input device switches mid-sentence, Parleq keeps your words instead of silently losing them — re-run with a tap.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Built for the enterprise. The OIDC-federation story for org
       buyers: one sign-in for everyone, audit attribution, no Parleq
       servers in the path. A DARK GRAPE band (from-[#23103a] to-[#140622])
       that bookends the page in the hero's grape atmosphere and reads as a
       distinct, weightier moment. Text is grape-200 (white emphasis) so it
       passes contrast on the grape ground; amber carries the eyebrow,
       bullets, and links. id anchors the hero pill + the site-wide
       "Enterprise" nav link; scroll-mt clears the heading on jump. -->
  <section
    id="enterprise"
    data-reveal
    class="scroll-mt-20 bg-gradient-to-br from-[#23103a] to-[#140622] text-[color:var(--color-grape-200)]"
  >
    <div class="mx-auto max-w-3xl px-6 py-20 sm:py-24">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-[color:var(--color-accent)]">
        For organizations
      </p>
      <h2 class="mt-4 font-display text-3xl leading-[1.1] font-medium tracking-tight text-white sm:text-4xl">
        Built for the enterprise.
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-[color:var(--color-grape-200)]">
        One corporate sign-in backs cloud cleanup for every employee — not just the engineers with a CLI configured. The user authenticates once with your identity provider (Okta, Microsoft Entra ID, or any OIDC IdP); Parleq federates that into AWS Bedrock or Google Cloud Vertex AI and mints short-lived per-cloud credentials at call time. No per-user API keys to distribute or rotate, and no long-lived cloud secret on the device.
      </p>
      <ul class="mt-8 space-y-4 text-[15px] leading-relaxed text-[color:var(--color-grape-200)]">
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[color:var(--color-accent)]"></span>
          <span><strong class="font-semibold text-white">One sign-in for the whole company.</strong> Sales, support, and ops sign in with the same account they already have — federated identity, not a developer-only path.</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[color:var(--color-accent)]"></span>
          <span><strong class="font-semibold text-white">Per-user audit attribution.</strong> The federated session carries the signed-in user's identity, so CloudTrail and Cloud Audit Logging attribute every cleanup call to the actual person.</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[color:var(--color-accent)]"></span>
          <span><strong class="font-semibold text-white">No Parleq servers in the data path, ever.</strong> Tokens go to your IdP and your cloud's STS endpoints; transcript text goes only to the LLM endpoint you already configured. There is no Parleq cloud service to review.</span>
        </li>
        <li class="flex gap-3">
