    aria-label="See it in action"
    class="fixed bottom-6 left-1/2 z-40 inline-flex -translate-x-1/2 items-center gap-2 rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)]/90 px-4 py-2 text-sm font-medium text-[color:var(--color-text-muted)] shadow-sm backdrop-blur transition-opacity duration-300 hover:text-[color:var(--color-text)]"
  >
    See it in action
    <svg aria-hidden="true" class="animate-scroll-cue h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m6 9 6 6 6-6" />
    </svg>
  </button>

  <!-- Reveal-on-scroll + scroll-cue behavior. is:inline so it runs
       immediately on this page without Astro's module hoisting (it
       touches only homepage DOM, needs no bundling, and must apply
       .reveal before first paint of below-the-fold sections). -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Reveal-on-scroll. If the visitor prefers reduced motion we do
      // NOTHING — content stays fully visible, never gets .reveal. This
      // ordering matters: applying .reveal first would hide content for
      // a reduced-motion user.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const targets = document.querySelectorAll('[data-reveal]');
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-visible');
                obs.unobserve(entry.target); // once-only
              }
            });
          },
          { threshold: 0, rootMargin: '0px' }
        );
        // Hide only elements that start BELOW the viewport: anything
        // already in view on load keeps both classes in the same frame
        // (no one-frame blank flash); the observer's async first
        // callback then no-ops on them via the once-only unobserve.
        targets.forEach((el) => {
          el.classList.add('reveal');
          if (el.getBoundingClientRect().top < window.innerHeight) {
            el.classList.add('reveal-visible');
          }
          observer.observe(el);
        });
      }

      // Scroll cue: smooth-scroll to the Refinement showcase, then
      // auto-hide once the visitor leaves the hero.
      const cue = document.getElementById('scroll-cue');
      if (cue) {
        cue.addEventListener('click', () => {
          // Honor the OS reduced-motion preference: instant jump for
          // those users, smooth glide for everyone else.
          const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'instant'
            : 'smooth';
          // Scroll to the on-device showcase (the immediate payoff after the
          // hero demo); fall back to the refinement section, then a nudge.
          const target = document.getElementById('on-device') || document.getElementById('refine');
          if (target) {
            target.scrollIntoView({ behavior });
          } else {
            window.scrollBy({ top: window.innerHeight * 0.85, behavior });
          }
        });
        const toggleCue = () => {
          const hidden = window.scrollY > 80;
          cue.classList.toggle('opacity-0', hidden);
          cue.classList.toggle('pointer-events-none', hidden);
        };
        toggleCue();
        window.addEventListener('scroll', toggleCue, { passive: true });
      }

      // Hero live cleanup demo. Loops through a few examples: a raw
      // spoken transcript types out word-by-word in muted monospace
      // (with a blinking caret), the filler words then dissolve, and the
      // line crossfades into the cleaned sentence in the site text color.
      // ~10–12s/cycle. Decorative only (the region is aria-hidden); the
      // h1 carries the real message. Disabled under reduced motion — the
      // server-rendered cleaned first line stays put. Paused via an
      // IntersectionObserver while the hero is scrolled off-screen so we
      // don't burn timers in the background.
      const demoHost = document.getElementById('hero-demo');
      const demoText = document.getElementById('hero-demo-text');
      const demoReduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (demoHost && demoText && !demoReduceMotion) {
        // Each example: raw words (with a `filler` flag on the words that
        // dissolve) plus the cleaned sentence. The raw words include
        // their trailing space so the typed line spaces correctly; the
        // CSS .hero-demo-word preserves that space.
        // Each example pairs a raw spoken transcript with the cleaned
        // result, and names the ONE token the on-device cleanup changed
        // (`highlight`) so the eye catches the magic. The set is chosen to
        // show the distinctive on-device transforms — numbers/percents, the
        // voiceprint disambiguation, a biased dictionary term, and
        // punctuation — not just generic disfluency removal.
        const examples = [
          {
            // Numbers + percent normalization (deterministic, on-device).
            raw: [
              { t: 'we' },
              { t: 'cut' },
              { t: 'latency' },
              { t: 'by' },
              { t: 'forty' },
              { t: 'five' },
              { t: 'percent' },
              { t: 'last' },
              { t: 'quarter' },
            ],
            cleaned: 'We cut latency by 45% last quarter.',
            highlight: '45%',
          },
          {
            // Voiceprint disambiguation: the name "Keavi" sounds like the
            // fruit "kiwi"; an enrolled voiceprint tells them apart by sound.
            raw: [
              { t: 'um', filler: true },
              { t: 'i' },
              { t: 'caught' },
              { t: 'up' },
              { t: 'with' },
              { t: 'kiwi' },
              { t: 'about' },
              { t: 'the' },
              { t: 'roadmap' },
            ],
            cleaned: 'I caught up with Keavi about the roadmap.',
            highlight: 'Keavi',
          },
          {
            // Custom dictionary term recovered from ASR biasing — the app's
            // own name: "parlay" (a real word ASR reaches for) → "Parleq",
            // often with no cleanup model at all.
            raw: [
              { t: 'okay', filler: true },
              { t: 'i' },
              { t: 'pushed' },
              { t: 'the' },
              { t: 'parlay' },
              { t: 'update' },
              { t: 'last' },
              { t: 'night' },
            ],
            cleaned: 'I pushed the Parleq update last night.',
            highlight: 'Parleq',
          },
          {
            // Punctuation + casing + disfluency removal.
            raw: [
              { t: 'um', filler: true },
              { t: 'so', filler: true },
              { t: 'can' },
              { t: 'we' },
              { t: 'move' },
              { t: 'the' },
              { t: 'standup' },
              { t: 'to' },
              { t: 'thursday' },
            ],
            cleaned: 'Can we move the standup to Thursday?',
            highlight: '?',
          },
        ];

        // Per-word typing cadence ~80–120ms with slight variance, so it
        // reads like words arriving as you speak rather than a metronome.
        // The longer beats (pre-clean pause, 3s hold, an inter-example
        // settle) carry the cycle to the ~10–12s target without speeding
        // the typing into a typewriter clatter.
        const WORD_MIN = 80;          // ms — fastest gap between words
        const WORD_MAX = 120;         // ms — slowest gap between words
        const PRE_CLEAN_PAUSE = 700;  // ms — beat after the last raw word
        const COLLAPSE_MS = 450;      // ms — filler dissolve (matches CSS)
        const HOLD_MS = 3400;         // ms — dwell on the cleaned line
        const FADE_MS = 500;          // ms — line crossfade (matches CSS)
        const SETTLE_MS = 600;        // ms — quiet gap before the next example

        let exIndex = 0;
        let running = false;
        // Starts false: the IntersectionObserver's initial callback is the
        // single start path, so the loop never runs while the hero is
        // off-screen (e.g. a deep-link landing on #enterprise).
        let visible = false;
        // Maps each *pending* timeout id → its promise resolver. A timer
        // removes its own entry once it fires, so the map stays bounded
        // over a long-running loop. On cancellation clearTimers() both
        // clears the timeout AND resolves the pending promise — without
        // that, the cycle() coroutine suspended on `await wait(...)` would
        // hang forever (leaking its closure). Resolving lets it resume,
        // hit the generation-token live() check, and return cleanly.
        const timers = new Map();
        const wait = (ms) =>
          new Promise((resolve) => {
            const id = setTimeout(() => {
              timers.delete(id);
              resolve();
            }, ms);
            timers.set(id, resolve);
          });
        const clearTimers = () => {
          timers.forEach((resolve, id) => {
            clearTimeout(id);
            resolve();
          });
          timers.clear();
        };
        // Per-run generation token. stop() bumps it, so a cycle() that was
        // suspended in an uncancellable await (e.g. the double-rAF below,
        // which clearTimers can't reach) detects on resume that its run is
        // stale and bails — even if start() has since flipped `running`
        // back to true. Guards against two cycles racing the same node.
        let generation = 0;
        const rand = (min, max) => min + Math.random() * (max - min);

        // Replace the line's contents with a fresh set of word spans,
        // returning them so the caller can collapse fillers later.
        const buildRawSpans = (ex) => {
          demoText.innerHTML = '';
          demoText.className = 'hero-demo-raw hero-demo-fade';
          demoText.style.opacity = '1';
          const spans = ex.raw.map((w, i) => {
            const span = document.createElement('span');
            span.className = 'hero-demo-word';
            // Trailing space on every word but the last keeps spacing
            // intact even as neighbors collapse.
            span.textContent = i < ex.raw.length - 1 ? w.t + ' ' : w.t;
            span.dataset.filler = w.filler ? '1' : '0';
            return span;
          });
          return spans;
        };

        // One full beat for a single example. `myGen` pins this run; any
        // await/rAF resume re-checks both `running` and the generation so
        // a stale (stopped-then-restarted) cycle never touches the DOM.
        const cycle = async (ex) => {
          const myGen = generation;
          const live = () => running && generation === myGen;

          // --- Dictation phase: type words in with a blinking caret. ---
          const spans = buildRawSpans(ex);
          const caret = document.createElement('span');
          caret.className = 'hero-demo-caret';
          for (let i = 0; i < spans.length; i++) {
            if (!live()) return;
            demoText.appendChild(spans[i]);
            demoText.appendChild(caret); // caret trails the latest word
            await wait(rand(WORD_MIN, WORD_MAX));
            if (!live()) return;
          }

          // --- Pre-clean beat, then drop the caret. ---
          await wait(PRE_CLEAN_PAUSE);
          if (!live()) return;
          if (caret.parentNode) caret.parentNode.removeChild(caret);

          // --- Cleanup phase: dissolve the fillers, then crossfade the
          //     remaining raw text into the cleaned sentence. ---
          spans.forEach((span) => {
            if (span.dataset.filler === '1') span.classList.add('is-dropped');
          });
          await wait(COLLAPSE_MS);
          if (!live()) return;

          // Crossfade out, swap to the cleaned line in site text color,
          // crossfade in. A whole-line fade reads as "it settled" without
          // a jarring word-for-word remap.
          demoText.style.opacity = '0';
          await wait(FADE_MS);
          if (!live()) return;
          demoText.className = 'hero-demo-cleaned hero-demo-fade';
          // Render the cleaned line with the one changed token emphasized, so
          // the eye lands on what the on-device cleanup actually did. Built
          // from text nodes + a span (no innerHTML) to stay injection-safe.
          demoText.textContent = '';
          const hi = ex.highlight;
          const at = hi ? ex.cleaned.indexOf(hi) : -1;
          if (at >= 0) {
            demoText.appendChild(document.createTextNode(ex.cleaned.slice(0, at)));
            const mark = document.createElement('span');
            mark.className = 'hero-demo-mark';
            mark.textContent = hi;
            demoText.appendChild(mark);
            demoText.appendChild(document.createTextNode(ex.cleaned.slice(at + hi.length)));
          } else {
            demoText.textContent = ex.cleaned;
          }
          demoText.style.opacity = '0';
          // Double rAF so the opacity-0 frame commits before we fade in.
          // This await isn't timer-tracked, so the post-resume live()
          // check (via the generation token) is what cancels it.
          await new Promise((resolve) =>
            requestAnimationFrame(() =>
              requestAnimationFrame(() => resolve())
            )
          );
          if (!live()) return;
          demoText.style.opacity = '1';

          // --- Hold the cleaned line, then fade the whole line out and
          //     settle into a brief quiet gap before the next example. ---
          await wait(HOLD_MS);
          if (!live()) return;
          demoText.style.opacity = '0';
          await wait(FADE_MS);
          if (!live()) return;
          await wait(SETTLE_MS);
        };

        const loop = async () => {
          if (running) return; // guard against double-start on re-entry
          running = true;
          // Pin this loop's run. A synchronous stop()+start() (e.g. an
          // observer callback delivering leave+enter in one invocation)
          // bumps `generation` and spins up a fresh loop; this guard stops
          // the old loop from launching another cycle() into the new run,
          // and from clearing the new run's `running` flag on its exit.
          const loopGen = generation;
          while (running && visible && generation === loopGen) {
            await cycle(examples[exIndex]);
            if (!running || generation !== loopGen) break;
            exIndex = (exIndex + 1) % examples.length;
          }
          if (generation === loopGen) running = false;
        };
        const start = () => {
          if (!running && visible) loop();
        };
        const stop = () => {
          running = false;
          generation++; // invalidate any suspended cycle's run token
          clearTimers();
        };

        // Pause the loop while the hero is scrolled away; resume (from a
        // clean example boundary) when it returns into view.
        const heroObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              visible = entry.isIntersecting;
              if (visible) start();
              else stop();
            });
          },
          { threshold: 0 }
        );
        // The observer fires an initial callback (a microtask after
        // observe()) with the hero's current visibility, which is the only
        // thing that flips `visible` true and starts the loop.
        heroObserver.observe(demoHost);
      }

      // Refinement scenario carousel. Swap-pager: all slides are in the
      // DOM; we toggle `hidden` + aria-hidden so only one shows. Dots are
      // generated from the slides; chevrons step. Autoplay advances every
      // 6s and re-arms on any manual change; it pauses on hover/focus and
      // is disabled entirely under prefers-reduced-motion. The incoming
      // slide gets a short opacity fade, also gated on reduced motion.
      const carousel = document.getElementById('refine-carousel');
      const slides = carousel
        ? Array.from(carousel.querySelectorAll('.refine-slide'))
        : [];
      if (carousel && slides.length > 0) {
        const dotsHost = document.getElementById('refine-dots');
        const announce = document.getElementById('refine-announce');
        const prevBtn = document.getElementById('refine-prev');
        const nextBtn = document.getElementById('refine-next');
        const N = slides.length;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let index = 0;
        let timer = null;
        // Suppresses the entrance fade on the very first render so the
        // already-visible first slide doesn't flash to opacity 0 and back
        // on load. Real fades only run on subsequent (manual/auto) swaps.
        let initialized = false;

        // Build one dot per slide; the slide's name becomes its tooltip.
        const dots = slides.map((slide, i) => {
          const name = slide.getAttribute('data-slide-name') || `Scenario ${i + 1}`;
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.setAttribute('aria-label', name);
          dot.setAttribute('title', name);
          dot.className =
            'h-2.5 w-2.5 rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-border)] transition-colors hover:bg-[color:var(--color-text-subtle)] hover:border-[color:var(--color-text-subtle)]';
          dot.addEventListener('click', () => go(i));
          dotsHost && dotsHost.appendChild(dot);
          return dot;
        });

        const render = () => {
          slides.forEach((slide, i) => {
            const active = i === index;
            if (active) {
              slide.removeAttribute('hidden');
              slide.removeAttribute('aria-hidden');
              // Gated entrance fade for the incoming slide — skipped on
              // the first render (slide already visible) and under reduced
              // motion, both of which want an instant, flash-free show.
              if (!reduceMotion && initialized) {
                slide.style.transition = 'opacity 300ms ease';
                slide.style.opacity = '0';
                // Double rAF so the browser commits an opacity-0 frame
                // before we flip to 1 — a single rAF can get coalesced and
                // skip the transition.
                requestAnimationFrame(() => {
                  requestAnimationFrame(() => {
                    slide.style.opacity = '1';
                  });
                });
              } else {
                slide.style.opacity = '1';
              }
            } else {
              slide.setAttribute('hidden', '');
              slide.setAttribute('aria-hidden', 'true');
              slide.style.opacity = '';
              // Clear the inline fade transition so inactive slides don't
              // carry a dangling property between activations.
              slide.style.transition = '';
            }
          });
          dots.forEach((dot, i) => {
            const active = i === index;
            if (active) {
              dot.setAttribute('aria-current', 'true');
              dot.classList.add('bg-[color:var(--color-accent)]', 'border-[color:var(--color-accent)]');
              dot.classList.remove('bg-[color:var(--color-border)]', 'border-[color:var(--color-border)]', 'hover:bg-[color:var(--color-text-subtle)]', 'hover:border-[color:var(--color-text-subtle)]');
            } else {
              dot.removeAttribute('aria-current');
              dot.classList.remove('bg-[color:var(--color-accent)]', 'border-[color:var(--color-accent)]');
              dot.classList.add('bg-[color:var(--color-border)]', 'border-[color:var(--color-border)]', 'hover:bg-[color:var(--color-text-subtle)]', 'hover:border-[color:var(--color-text-subtle)]');
            }
          });
          // Announce the active scenario to screen readers — but only on
          // real swaps, so page load doesn't fire an unsolicited read.
          if (announce && initialized) {
            announce.textContent =
              slides[index].getAttribute('data-slide-name') || `Scenario ${index + 1}`;
          }
        };

        const arm = () => {
          if (reduceMotion) return; // no autoplay for reduced-motion users
          if (timer) clearInterval(timer);
          timer = setInterval(() => go(index + 1), 6000);
        };
        const disarm = () => {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        };

        // go() is the single mutation path: wrap-around index, re-render,
        // and re-arm autoplay so a manual change restarts the dwell clock.
        function go(i) {
          index = ((i % N) + N) % N;
          render();
          arm();
        }

        prevBtn && prevBtn.addEventListener('click', () => go(index - 1));
        nextBtn && nextBtn.addEventListener('click', () => go(index + 1));

        // Pause autoplay while the visitor is interacting with the region.
        // focusin/focusout bubble, so the focusout handler checks
        // relatedTarget — re-arm only when focus actually leaves the
        // carousel, not when it moves between a dot and a chevron.
        carousel.addEventListener('mouseenter', disarm);
        carousel.addEventListener('mouseleave', arm);
        carousel.addEventListener('focusin', disarm);
        carousel.addEventListener('focusout', (e) => {
          if (!carousel.contains(e.relatedTarget)) arm();
        });

        render();
        // From here on, swaps animate; the initial paint above did not.
        initialized = true;
        arm();
      }
    });
  </script>
</Layout>
