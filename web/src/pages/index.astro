---
import Layout from '../layouts/Layout.astro';
import OverlayMockup from '../components/OverlayMockup.astro';
import TransformCard from '../components/TransformCard.astro';
import ConcordFlow from '../components/ConcordFlow.astro';
import Logo from '../components/Logo.astro';
import StickyHeader from '../components/StickyHeader.astro';
import { fetchLatestRelease } from '../lib/release';

const release = await fetchLatestRelease();
const releasesUrl = release.releasePageUrl;
const repoUrl = 'https://github.com/parleq/parleq-speech';

// Direct .dmg URL when the release fetch succeeded; falls back to
// the Releases page URL if the API was unreachable. Either way the
// CTA still works — tester just sees the page instead of a direct
// download in the fallback case.
const downloadUrl = release.downloadUrl;

// JSON-LD: SoftwareApplication schema for search rich results.
// Static fields only — release-specific values would go stale in
// search caches between releases anyway.
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Parleq',
  operatingSystem: 'macOS 14 or later (Apple Silicon)',
  applicationCategory: 'UtilitiesApplication',
  description:
    'Local-first AI dictation for macOS. Press a hotkey, speak, and watch your words appear cleaned up — speech recognition runs on-device, audio never leaves your Mac.',
  url: 'https://parleq.app/',
  downloadUrl: `${repoUrl}/releases/latest`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

// All twelve capabilities, flattened into a single uniform grid. Each
// card is glyph + title + ONE distilled sentence, and links to where the
// full story lives (how-it-works stage/section anchors, or /enterprise).
// `icon` selects an inline line-glyph drawn in the markup below — the
// same hand-rolled SVGs the old bento layout used, no icon library. The
// full body copy these distill from now lives at each `href`; see the
// how-it-works stages, Reference Windows, refine-loop, and /enterprise.
const base = `${import.meta.env.BASE_URL}`.replace(/\/$/, '');
const capabilities = [
  {
    title: 'On-device speech recognition',
    blurb: 'Parakeet TDT v3 runs on the Apple Neural Engine — audio never leaves your Mac, and nothing is written to disk.',
    icon: 'mic',
    href: `${base}/how-it-works/#stage-transcribe`,
  },
  {
    title: 'Compliance-friendly by default',
    blurb: 'Audio stays in memory, logs are metrics-only, secrets live in the Keychain, and dictation fails closed when you sign out.',
    icon: 'shield',
    href: `${base}/enterprise/`,
  },
  {
    title: 'Never lose a dictation',
    blurb: 'If your mic goes silent or your audio device switches mid-sentence, Parleq tells you and keeps what you said. Lost one anyway? Hold the hotkey and tap R to re-run it. Recent cleaned text also stays in an in-memory list — wiped on quit, never written to disk.',
    icon: 'clock-rewind',
    href: `${base}/how-it-works/#stage-capture`,
  },
  {
    title: 'Teach it the words it gets wrong',
    blurb: 'A custom dictionary biases the speech model toward your names and jargon, with aliases and a per-term opt-out.',
    icon: 'book',
    href: `${base}/how-it-works/#stage-transcribe`,
  },
  {
    title: 'Tell sound-alike words apart',
    blurb: 'Optionally enroll a term in your own voice so Parleq can separate a name like "Keavi" from "kiwi" by sound. On-device, opt-in per term — and what\'s kept is an encrypted voiceprint, never a recording.',
    icon: 'voiceprint',
    href: `${base}/how-it-works/#voice-enrollment`,
  },
  {
    title: 'Learns from your corrections',
    blurb: 'Opt-in: when you keep fixing the same word, Parleq asks your existing cleanup model to suggest dictionary improvements.',
    icon: 'sparkle',
    href: `${base}/how-it-works/#stage-cleanup`,
  },
  {
    title: 'One-tap transform presets',
    blurb: 'Your own named rewrites appear as chips on the overlay — tap to restyle before pasting, or set one as an app default.',
    icon: 'gear',
    href: `${base}/how-it-works/#refine-loop`,
  },
  {
    title: 'Reference Windows',
    blurb: 'Point at a window, file, or clipboard so the LLM sees your context — captures stay in memory and never touch disk.',
    icon: 'window',
    href: `${base}/how-it-works/#reference-windows`,
  },
  {
    title: 'Use the AI you already have',
    blurb: 'Pick Gemini, OpenAI, Bedrock, Vertex, or Azure — with pasted keys or the CLI sign-in your other tools already use. Cleanup can also run entirely on-device (no cloud account, no per-call cost, ~4 GB model download).',
    icon: 'chips',
    href: `${base}/how-it-works/#stage-cleanup`,
  },
  {
    title: 'Pastes where you started',
    blurb: 'The focused app is captured at hotkey-down, so cleaned text lands in the right window even if your attention drifts.',
    icon: 'cursor',
    href: `${base}/how-it-works/#stage-paste`,
  },
  {
    title: 'A home of its own',
    blurb: 'Hold the hotkey and tap P for the Parleq window — Recent Dictations, Stats, Settings, and About, with no Dock clutter.',
    icon: 'house',
    href: `${base}/how-it-works/#gestures`,
  },
  {
    title: 'MDM-deployable for IT admins',
    blurb: 'Push a managed profile that pins the provider, model list, OIDC issuer, and destinations so users can\'t re-point the app.',
    icon: 'lock',
    href: `${base}/enterprise/`,
  },
];
---

<Layout title="Parleq — Local-first AI dictation for macOS">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(softwareSchema)} />
  <StickyHeader downloadUrl={downloadUrl} />
  <!-- Hero: framed dark-grape panel with in-panel nav and ConcordFlow art (Beat 1).
       Responsive frame: content grows with the window (cap 1700px), a small ~20px margin on
       desktop, and FULL-BLEED on mobile (margin → 0, no rounding). -->
  <section class="mx-auto max-w-[1700px] px-0 py-0 sm:px-5 sm:py-5">
    <div
      class="relative overflow-hidden rounded-none px-5 pb-28 pt-5 sm:rounded-[28px] sm:px-10"
      style="background:
               radial-gradient(58% 74% at 72% 52%, color-mix(in srgb, var(--color-grape-600) 55%, transparent), transparent 68%),
               linear-gradient(180deg, #1d0b33 0%, #140622 100%);
             box-shadow: 0 30px 80px -30px rgba(20,7,32,.7);"
    >
      <!-- IN-PANEL HEADER: logo left, nav right (replaces SiteHeader for this page). -->
      <header class="relative flex items-center justify-between gap-4 border-b pb-4" style="border-color: color-mix(in srgb, var(--color-grape-300) 16%, transparent);">
        <Logo dark height="30" />

        <!-- Mobile hamburger (hero panel) — white icon on dark background -->
        <button
          id="hero-menu-btn"
          type="button"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="hero-mobile-menu"
          class="inline-flex h-9 w-9 items-center justify-center rounded-md text-white md:hidden"
        >
          <svg id="hero-hamburger-icon" aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="6" x2="20" y2="6" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="18" x2="20" y2="18" />
          </svg>
          <svg id="hero-close-icon" aria-hidden="true" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="6" y1="6" x2="18" y2="18" />
            <line x1="18" y1="6" x2="6" y2="18" />
          </svg>
        </button>

        <nav class="hidden items-center gap-6 text-sm md:flex" style="color: var(--color-grape-100);">
          <a href={`${base}/how-it-works/`} class="transition-colors hover:text-[color:var(--color-panel-ink)]">How it works</a>
          <a href={`${base}/docs/`} class="transition-colors hover:text-[color:var(--color-panel-ink)]">Docs</a>
          <a href={`${base}/enterprise/`} class="transition-colors hover:text-[color:var(--color-panel-ink)]">Enterprise</a>
          <a href={`${base}/about/`} class="transition-colors hover:text-[color:var(--color-panel-ink)]">About</a>
          <a href={repoUrl} class="transition-colors hover:text-[color:var(--color-panel-ink)]">GitHub ↗</a>
          <a href={downloadUrl} class="inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-sm font-semibold text-white" style="background: var(--color-accent);">
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v11M8 11l4 4 4-4M5 20h14"></path></svg>
            Download for macOS
          </a>
        </nav>
      </header>

      <!-- Hero mobile nav dropdown (md:hidden, dark-panel themed) -->
      <div
        id="hero-mobile-menu"
        hidden
        class="md:hidden"
        style="border-top: 1px solid color-mix(in srgb, var(--color-grape-300) 16%, transparent);"
      >
        <nav class="flex flex-col gap-1 py-4 text-sm font-medium" style="color: var(--color-grape-100);">
          <a href={`${base}/how-it-works/`} class="py-2 transition-colors hover:text-white">How it works</a>
          <a href={`${base}/docs/`} class="py-2 transition-colors hover:text-white">Docs</a>
          <a href={`${base}/enterprise/`} class="py-2 transition-colors hover:text-white">Enterprise</a>
          <a href={`${base}/about/`} class="py-2 transition-colors hover:text-white">About</a>
          <a href={repoUrl} class="py-2 transition-colors hover:text-white">GitHub ↗</a>
          <a
            href={downloadUrl}
            class="mt-3 inline-flex items-center justify-center gap-1.5 rounded-full px-4 py-2.5 text-sm font-semibold text-white"
            style="background: var(--color-accent);"
          >
            Download for macOS
          </a>
        </nav>
      </div>

      <div class="relative mt-10 grid items-center gap-10 lg:grid-cols-[40%_60%]">
        <!-- LEFT column: copy, CTAs, feature chips -->
        <div>
          <!-- Audio privacy pill (load-bearing required string). -->
          <span class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium" style="border-color: color-mix(in srgb, var(--color-grape-300) 35%, transparent); color: var(--color-grape-200); background: color-mix(in srgb, var(--color-grape-500) 20%, transparent);">
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
            Your voice never leaves your Mac
          </span>

          <!-- Semantic h1: carries the message for screen readers; the flow art is aria-hidden. -->
          <h1 class="font-display mt-6 text-5xl font-medium leading-[1.02] tracking-tight sm:text-6xl" style="color: var(--color-panel-ink);">
            Speak freely.<br /><span style="color: var(--color-grape-300);">Paste clean.</span>
          </h1>

          <p class="mt-6 max-w-md text-base leading-relaxed" style="color: color-mix(in srgb, var(--color-panel-ink) 80%, transparent);">
            <span style="color: var(--color-panel-ink);">Parleq</span> <span class="font-mono text-xs" style="color: var(--color-grape-200);">/PAR-lek/</span> is a local-first AI dictation app for macOS. Hold a hotkey and talk; the cleaned-up result pastes into whatever app was focused — speech recognition and cleanup can both run on your Mac, or use the cloud you bring.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href={downloadUrl}
              data-goatcounter-click="download-hero"
              class="inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm"
              style="background: var(--color-accent);"
            >
              Download for macOS{release.version && ` ${release.version}`}
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v11M8 11l4 4 4-4M5 20h14"></path></svg>
            </a>
            <a href="#refine" class="inline-flex items-center gap-2 rounded-full border px-6 py-3 text-sm font-semibold" style="border-color: color-mix(in srgb, var(--color-grape-300) 35%, transparent); color: var(--color-grape-100);">
              See it in action
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
            </a>
          </div>

          <p class="mt-4 text-xs" style="color: color-mix(in srgb, var(--color-grape-200) 60%, transparent);">
            Apache-2.0 · macOS 14+ · Apple Silicon required
          </p>

          <div class="mt-5 flex flex-wrap gap-2">
            <span class="chip-d">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg>
              Voiceprints
            </span>
            <span class="chip-d">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z"></path></svg>
              On-device cleanup
            </span>
            <span class="chip-d">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3 7 21M17 3l-2 18M4 8h16M3 16h16"></path></svg>
              Numbers &amp; punctuation
            </span>
            <span class="chip-d">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2zM6 17h12"></path></svg>
              Custom dictionary
            </span>
          </div>
        </div>

        <!-- RIGHT: ConcordFlow SVG art + three TransformCards (decorative; h1 carries the message). -->
        <div class="relative mx-auto h-[360px] w-full max-w-[560px]" aria-hidden="true">
          <ConcordFlow uid="hero" />
          <TransformCard
            variant="input"
            title="You speak"
            lines={[
              {text: 'so we processed <span class="u-tok">eight point nine</span> million rows. did the build pass and is it ready to ship?'},
              {text: 'the <span class="u-tok">parlay</span> docs are live. shipped some updates to <span class="u-tok">kiwi</span>.'}
            ]}
          />
          <TransformCard
            variant="engine"
            items={["Punctuation","Numbers","Voiceprints","Dictionary"]}
            credit="built on Concord (by Keavi)"
          />
          <TransformCard
            variant="output"
            title="Parleq pastes"
            lines={[
              {text: 'We processed <span class="mk-tok">8.9 million</span> rows. Did the build pass and is it ready to ship?'},
              {text: 'The <span class="mk-tok">Parleq</span> docs are live. Shipped some updates to <span class="mk-tok">Keavi</span>.'}
            ]}
          >
            <div class="mt-3 inline-flex items-center gap-1.5 text-[10px] font-medium" style="color:#7fd99a;">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"></path></svg>
              Pasted
            </div>
          </TransformCard>
        </div>
      </div>
    </div>
    <!-- Reveal trigger for the sticky header: once this scrolls above the viewport
         (i.e. the hero is gone), StickyHeader's observer slides the bar in. -->
    <div id="hero-sentinel" aria-hidden="true" class="h-px w-full"></div>
  </section>

  <!-- On-device cleanup showcase. Lifts the four distinctive transforms out
       of the flat capability grid into a focused before→after strip — the
       "here's how cool it actually is" the homepage was missing. Each card
       reuses .hero-demo-mark to highlight the changed token. -->
  <section id="on-device" data-reveal class="zone-grape scroll-mt-20 border-t border-[color:var(--color-border-subtle)]">
    <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-[color:var(--color-accent)]">
        On-device cleanup
      </p>
      <h2 class="mt-4 font-display text-3xl leading-[1.1] font-medium tracking-tight sm:text-4xl">
        Smart cleanup. On your Mac.
      </h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-[color:var(--color-text-muted)]">
        Local speech recognition is table stakes now. What sets Parleq apart is the cleanup that runs right beside it — punctuation, numbers, your own jargon, even sound-alike names. Your custom terms are recognized on-device no matter which cleanup you choose; pick Parleq's on-device cleanup and the punctuation, number, and voiceprint work never leaves your Mac either.
      </p>

      <div class="mt-12 grid gap-4 sm:grid-cols-2">
        <!-- Each card stacks raw → cleaned (block-per-line) so it stays
             scannable on mobile, with an sr-only "becomes" cue between them
             for screen readers (the ↓ glyph is aria-hidden). Distinct
             examples from the hero loop so the section reads as new evidence,
             not a rerun. -->

        <!-- Punctuation, casing & disfluency -->
        <div class="rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-5">
          <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-[color:var(--color-accent)]">Punctuation &amp; casing</p>
          <div class="mt-3 font-mono text-sm leading-relaxed">
            <span class="block text-[color:var(--color-text-subtle)]">"did the build pass and is it ready to ship"</span>
            <span class="sr-only">becomes</span>
            <span aria-hidden="true" class="my-0.5 block text-[color:var(--color-text-subtle)]">↓</span>
            <span class="block text-[color:var(--color-text)]">Did the build pass and is it ready to ship<span class="hero-demo-mark">?</span></span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-text-muted)]">
            Capitals, end marks and question marks land where they belong, and the filler words drop out.
          </p>
        </div>

        <!-- Numbers, percents & ranges -->
        <div class="rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-5">
          <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-[color:var(--color-accent)]">Numbers &amp; percents</p>
          <div class="mt-3 font-mono text-sm leading-relaxed">
            <span class="block text-[color:var(--color-text-subtle)]">"we processed eight point nine million rows"</span>
            <span class="sr-only">becomes</span>
            <span aria-hidden="true" class="my-0.5 block text-[color:var(--color-text-subtle)]">↓</span>
            <span class="block text-[color:var(--color-text)]">We processed <span class="hero-demo-mark">8.9 million</span> rows.</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-text-muted)]">
            Spelled-out numbers, percents and ranges become digits — "forty five percent" → "45%", "three to five days" → "3 to 5 days".
          </p>
        </div>

        <!-- Custom dictionary via ASR biasing -->
        <div class="rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-5">
          <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-[color:var(--color-accent)]">Your words, recognized</p>
          <div class="mt-3 font-mono text-sm leading-relaxed">
            <span class="block text-[color:var(--color-text-subtle)]">"the parlay docs are live"</span>
            <span class="sr-only">becomes</span>
            <span aria-hidden="true" class="my-0.5 block text-[color:var(--color-text-subtle)]">↓</span>
            <span class="block text-[color:var(--color-text)]">The <span class="hero-demo-mark">Parleq</span> docs are live.</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-text-muted)]">
            A custom dictionary biases the speech model toward your names and jargon — so "parlay" lands as "Parleq", often with no cleanup model at all.
          </p>
        </div>

        <!-- Voiceprint disambiguation -->
        <div class="rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-5">
          <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-[color:var(--color-accent)]">Sound-alikes, told apart</p>
          <div class="mt-3 font-mono text-sm leading-relaxed">
            <span class="block text-[color:var(--color-text-subtle)]">"shipped some updates to kiwi"</span>
            <span class="sr-only">becomes</span>
            <span aria-hidden="true" class="my-0.5 block text-[color:var(--color-text-subtle)]">↓</span>
            <span class="block text-[color:var(--color-text)]">shipped some updates to <span class="hero-demo-mark">Keavi</span></span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-text-muted)]">
            Some names sound just like an everyday word — the app "Keavi" and the fruit "kiwi". Enroll the name in your own voice and Parleq keeps them straight by sound; what's kept is an encrypted voiceprint, never a recording.
          </p>
        </div>
      </div>

      <p class="mt-8 text-sm text-[color:var(--color-text-muted)]">
        Prefer a cloud model? Parleq also speaks to Gemini, OpenAI, Bedrock, Vertex and Azure — your choice, per the privacy posture you want.
      </p>
    </div>
  </section>

  <!-- Refinement showcase, as a scenario CAROUSEL. The overlay is the
       one surface every Parleq feature lives on, so the pager walks
       through five contexts a user will recognize — refinement (email,
       code review), one-tap presets, reference windows, and teaching it
       your words — each paired with a CSS-built mockup of the actual
       overlay (see OverlayMockup.astro). Mechanics: all five slides are
       in the DOM; inactive ones carry the `hidden` attribute. The script
       at the bottom of the page is a swap-pager (no sliding track) with
       prev/next chevrons, dot indicators, motion-gated autoplay, and a
       reduced-motion-gated fade on the incoming slide. -->
  <section id="refine" data-reveal class="scroll-mt-20 border-t border-[color:var(--color-border-subtle)] bg-[color:var(--color-bg)]">
    <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-[color:var(--color-accent)]">
        The overlay
      </p>
      <h2 class="mt-4 font-display text-3xl leading-[1.1] font-medium tracking-tight sm:text-4xl">
        Talk it into shape.
      </h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-[color:var(--color-text-muted)]">
        Most dictation tools clean up your words once and you're stuck with whatever they decide. Parleq lets you keep talking. While the overlay is open, hold the hotkey again — your next sentence becomes an edit instruction over the text you already have. Reshape tone, reach for a one-tap preset, point at a window for context, or teach it a word it keeps missing. When it's right, tap the hotkey to paste.
      </p>

      <!-- Carousel. role/aria-roledescription mark it as a carousel for
           assistive tech; the slides region is announced as the active
           panel. -->
      <div
        id="refine-carousel"
        role="region"
        aria-roledescription="carousel"
        aria-label="Parleq scenarios"
        class="mt-12"
      >
        <!-- Visually-hidden live region: announces the active scenario's
             name to screen readers when the slide changes (including on
             autoplay, where there's no user gesture to trigger a read). -->
        <div id="refine-announce" class="sr-only" aria-live="polite"></div>

        <!-- Slide stack. Each slide: copy-left / overlay-mockup-right on
             desktop (lg), stacked on mobile. Inactive slides carry the
             `hidden` attribute + aria-hidden; the script toggles them. -->
        <div class="relative">
          <!-- Slide 1: Workplace email — the existing single-refinement
               email chain. -->
          <div class="refine-slide grid items-center gap-10 lg:grid-cols-2" data-slide-name="Workplace email">
            <div>
