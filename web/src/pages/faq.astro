];

// FAQPage JSON-LD built from the same `sections` array the page
// renders, so schema and visible content can't drift. Answers are
// plain-texted: Google requires schema text to match what users see,
// and embedded <a> tags / markdown markers don't belong in
// acceptedAnswer text. Non-string answers (if any entry ever becomes
// JSX) are skipped rather than serialized wrong.
const plainText = (s) =>
  s
    .replace(/<[^>]*>/g, '')
    .replace(/\*\*/g, '')
    .replace(/`/g, '')
    .replace(/\s+/g, ' ')
    .trim();

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: sections.flatMap((section) =>
    section.items
      .filter((item) => typeof item.a === 'string')
      .map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: plainText(item.a) },
      }))
  ),
};

// Slugify a question into a stable, URL-safe anchor id. Lowercase,
// strip anything that isn't a word char or space, collapse runs of
// whitespace/hyphens into a single hyphen. Used for the section-chip
// links, the section header ids, and the per-question <details> ids
// (scroll-mt-20 clears the sticky header on jump / deep-link).
function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/['']/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

// Pre-compute a slug for every section title (the section headers
// double as their own anchors) and every question, deduplicating in
// the rare event two questions slugify to the same string.
const seenSlugs = new Set<string>();
function uniqueSlug(text: string): string {
  let base = slugify(text);
  let slug = base;
  let n = 2;
  while (seenSlugs.has(slug)) {
    slug = `${base}-${n}`;
    n += 1;
  }
  seenSlugs.add(slug);
  return slug;
}

const tocSections = sections.map((section) => ({
  title: section.title,
  slug: uniqueSlug(section.title),
  pricingNote: section.pricingNote ?? false,
  items: section.items.map((item) => ({
    q: item.q,
    a: item.a,
    slug: uniqueSlug(item.q),
  })),
}));

// Helper to render `**bold**` and backtick-code in the answer text.
// Astro's HTML rendering doesn't process Markdown by default in
// inline strings, so we do a tiny safe substitution here for the
// two cases the FAQ actually uses. Keeps the questions readable in
// the source frontmatter without forcing every answer into JSX.
function renderInline(text: string): string {
  return text
    .replace(/`([^`]+)`/g, '<code class="rounded bg-[color:var(--color-bg)] px-1 font-mono text-[13px]">$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong class="text-[color:var(--color-text)] font-semibold">$1</strong>');
}
---

<Layout title="FAQ — Parleq" description="Common questions about Parleq's privacy posture, provider choice, hardware support, customization, cost, and workplace use.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <FloatingNav active="faq" spacer={false} />

  <!-- Page hero: grape-panel-ink tinted band that extends to the very top so the dark
       FloatingNav pill floats over the light-purple (no white strip above it). Top padding
       clears the pill. -->
  <section class="border-b border-[color:var(--color-border-subtle)] bg-[color:var(--color-panel-ink)]">
    <div class="mx-auto max-w-3xl px-6 pb-12 pt-28 sm:pt-32">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-[color:var(--color-accent)]">FAQ</p>
      <h1 class="mt-3 font-display text-4xl leading-[1.1] font-medium tracking-tight sm:text-5xl">
        Frequently asked questions.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[color:var(--color-text-muted)]">
        Quick answers to the questions that come up most. If something here doesn't match what you're seeing, or if you have a question that should be added, <a href={`${repoUrl}/issues/new`} class="font-medium text-[color:var(--color-accent)] underline-offset-4 hover:underline">open an issue</a>.
      </p>
    </div>
  </section>

  <article class="mx-auto max-w-3xl px-6 pt-12 pb-24">

    <!-- Section chip row. "Privacy & data flow" gets grape theming to
         signal it's the primary privacy/on-device reference section.
         Each chip links to its section header's slug; headers carry
         scroll-mt-20 so the jump clears the sticky site header. -->
    <nav id="faq-top" aria-label="Jump to a section" class="flex flex-wrap gap-2">
      {tocSections.map((section) => {
        const isPrivacy = section.title === 'Privacy & data flow';
        return (
          <a
            href={`#${section.slug}`}
            class={`inline-flex items-center rounded-full border px-3.5 py-1.5 text-[13px] font-medium transition-colors ${
              isPrivacy
                ? 'border-[color:color-mix(in_srgb,var(--color-grape)_35%,var(--color-border-subtle))] bg-[color:color-mix(in_srgb,var(--color-grape)_6%,var(--color-surface))] text-[color:var(--color-grape)] hover:border-[color:var(--color-grape)] hover:text-[color:var(--color-grape-strong)]'
                : 'border-[color:var(--color-border-subtle)] bg-[color:var(--color-surface)] text-[color:var(--color-text-muted)] hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)]'
            }`}
          >
            {section.title}
          </a>
        );
      })}
    </nav>

    {tocSections.map((section) => (
      <section class="mt-16">
        <h2
          id={section.slug}
          class="scroll-mt-20 flex items-center gap-3 font-display text-2xl font-semibold tracking-tight text-[color:var(--color-text)]"
        >
          <span class="inline-block h-6 w-0.5 shrink-0 rounded-full bg-[color:var(--color-accent)]" aria-hidden="true"></span>
          {section.title}
        </h2>
        <div class="mt-6 space-y-3">
          {section.items.map((item) => (
            <details
              id={item.slug}
              class="faq-item scroll-mt-20 group rounded-2xl border border-[color:var(--color-border-subtle)] bg-[color:var(--color-surface)] px-5 transition-colors open:border-[color:var(--color-grape-200)] open:bg-[color:var(--color-surface)]"
            >
              <summary
                class="flex cursor-pointer list-none items-start justify-between gap-4 py-4 text-base font-semibold tracking-tight text-[color:var(--color-text)] sm:text-lg [&::-webkit-details-marker]:hidden"
              >
                <span>{item.q}</span>
                <svg
                  aria-hidden="true"
                  class="mt-1 h-4 w-4 shrink-0 text-[color:var(--color-accent)] transition-transform duration-200 group-open:rotate-45"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <path d="M8 3v10M3 8h10" />
                </svg>
              </summary>
              <p
                class="pb-5 text-[16px] leading-[1.7] text-[color:var(--color-text-muted)]"
                set:html={renderInline(item.a)}
              />
            </details>
          ))}
        </div>
        {section.pricingNote && <PricingNote />}
      </section>
    ))}

    <section class="mt-16 rounded-2xl border border-[color:var(--color-border-subtle)] bg-[color:var(--color-surface)] p-6 transition-colors hover:border-[color:var(--color-accent)]">
      <h2 class="text-lg font-semibold tracking-tight text-[color:var(--color-text)]">Question not here?</h2>
      <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-text-muted)]">
        File an issue on GitHub — answers that come up more than once tend to land in this FAQ. For provider-specific setup questions, the <a href={`${import.meta.env.BASE_URL}`.replace(/\/$/, '') + '/docs/'} class="font-medium text-[color:var(--color-accent)] underline-offset-4 hover:underline">docs</a> are usually the better starting point.
      </p>
    </section>
  </article>

  <!-- Deep-link support. Questions are <details> closed by default; if the
       URL targets one (on load or via hashchange), open it and scroll it
       into view so shared/bookmarked question links still land. Native
       <details> also auto-expand on find-in-page in Chromium, so no JS
       toggle logic is needed beyond this. -->
  <script is:inline>
    function openFromHash() {
      const hash = location.hash.slice(1);
      if (!hash) return;
      const el = document.getElementById(hash);
      if (el && el.tagName === 'DETAILS') {
        el.open = true;
        el.scrollIntoView();
      }
    }
    document.addEventListener('DOMContentLoaded', openFromHash);
    window.addEventListener('hashchange', openFromHash);
  </script>
</Layout>
