---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Parleq is a local-first AI dictation app for macOS. Press a hotkey, speak, see your words cleaned up and pasted into whatever app you were using.',
} = Astro.props;

// Canonical URL for this page. `Astro.site` comes from astro.config.mjs;
// the build uses Astro's default "directory" format, so built page paths
// end in "/" — matching exactly what GitHub Pages serves and preventing
// /faq vs /faq/ from splitting into two indexed URLs.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`.replace('//', '/')} />

    <!-- Fonts: Fraunces (display serif) + Inter (sans body). preconnect
         shaves the TLS round-trip; display=swap avoids FOIT. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
    />

    <!-- Open Graph / social card. og-image.png is rendered from
         og-image-src/og-image.html via scripts/make-og-image.sh. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Per-page head extras (JSON-LD structured data, etc.) -->
    <slot name="head" />

    <!-- GoatCounter web analytics: no cookies, no consent banner needed,
         open-source — chosen over GA4 deliberately for congruence with
         the privacy-first product. Counts only pageview + referrer.
         GoatCounter ignores localhost, so dev/preview visits don't count. -->
    <script
      data-goatcounter="https://parleq.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"></script>
  </head>
  <body>
    <slot />
    <footer class="border-t border-[color:var(--color-border-subtle)]">
      <div class="mx-auto max-w-5xl px-6 py-8 text-sm text-[color:var(--color-text-subtle)]">
        <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
          <div class="flex items-center gap-3">
            <span class="text-base font-semibold text-[color:var(--color-text)]">Parleq</span>
            <span>&middot;</span>
            <span>Made by <a href="https://keavi.app" class="hover:text-[color:var(--color-text)]">Keavi</a></span>
          </div>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
            <a href="https://github.com/parleq/parleq-speech" class="hover:text-[color:var(--color-text)]">GitHub</a>
            <a href="https://github.com/parleq/parleq-speech/blob/main/THIRD_PARTY_LICENSES.md" class="hover:text-[color:var(--color-text)]">Licenses</a>
            <a href="/privacy/" class="hover:text-[color:var(--color-text)]">Privacy</a>
            <a href="mailto:hello@parleq.app" class="hover:text-[color:var(--color-text)]">hello@parleq.app</a>
          </div>
        </div>
        <p class="mt-4 text-xs opacity-70">
          Apache-2.0 &middot; &copy; 2026 Keavi LLC &middot; A Virginia limited liability company
        </p>
      </div>
    </footer>
  </body>
</html>
