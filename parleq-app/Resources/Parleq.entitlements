<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Microphone capture for AVAudioEngine input. Without this,
         a Hardened Runtime build will fail to start the engine. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Outbound network connections: localhost:8767 (sidecar) and
         the Gemini LLM API. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- The bundled sidecar binary listens on 127.0.0.1:8767. With
         Hardened Runtime + nested-binary signing, the sidecar
         needs server permission to accept connections — even
         loopback ones. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- CoreML's MLModel uses JIT-compiled tensor graphs for some
         inference paths. allow-jit covers that under Hardened
         Runtime; without it the encoder/decoder/joint runs can
         fault with EXC_BAD_ACCESS in the JIT thunks. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
