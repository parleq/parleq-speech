<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Parleq</string>
    <key>CFBundleExecutable</key>
    <string>ParleqApp</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>com.parleq.app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Parleq</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.25.0</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Accessory app: no Dock icon, no main menu bar. The hotkey
         listener runs in the background and the overlay panel is the
         only visible UI. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Opt out of macOS automatic termination. Without this, the
         system will silently kill an LSUIElement app that has no
         visible windows after a short idle period. We have a hotkey
         listener and an in-process speech engine with model state
         that takes 30-60s to reload on first launch; the user
         expects Parleq to stay running until they explicitly quit
         via the menu bar. -->
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <!-- Sudden termination is the "OS may SIGKILL us during shutdown
         or low-memory conditions" policy. Disabled for the same
         reasons as automatic termination — Parleq should exit only
         through the menu-bar Quit path or an explicit signal, so
         in-flight LLM streams cancel cleanly. -->
    <key>NSSupportsSuddenTermination</key>
    <false/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- Enterprise OIDC federation: the custom URL scheme that the
         IdP redirects back to after an ASWebAuthenticationSession
         sign-in (parleq-auth://oidc/callback). Registering it here
         lets the OS route the redirect back into Parleq. The scheme
         is consumed only inside ASWebAuthenticationSession's
         callback handler; no AppKit URL-open handler is installed. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.parleq.app.oidc</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>parleq-auth</string>
            </array>
        </dict>
    </array>
    <!-- Mic permission prompt copy. Shown on first capture. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Parleq listens to your voice when you press the configured hotkey, transcribes locally, and pastes the result into the active app.</string>
    <!-- Sparkle update channel. The feed URL is fetched on app
         launch and on a periodic timer (24h default); each
         <enclosure> link in the feed is verified against the
         public Ed25519 key below before any update is installed.
         If the user disables automatic checks in Settings, only
         the explicit menu-bar "Check for Updates…" item hits this
         URL. See docs/SECURITY_REVIEW.md §"Auto-update" for the
         full posture. -->
    <key>SUFeedURL</key>
    <string>https://parleq.app/appcast.xml</string>
    <!-- Ed25519 public key. The matching private key lives only in
         the maintainer's macOS Keychain (and a password-manager
         backup) and never enters the repository or any built
         artifact. Sparkle on user machines refuses any update
         whose enclosure signature doesn't verify against this
         exact public key, so a downstream attacker who swapped
         out the appcast or the .dmg cannot push an arbitrary
         binary to existing installs. -->
    <key>SUPublicEDKey</key>
    <string>lYMPheHVJ0WKG3tUTqrvWRb0+tLKQVynVtbR8tJENZs=</string>
</dict>
</plist>
